#!/usr/bin/env ruby
# frozen_string_literal: true

# Intégration continue locale — les étapes sont dans config/ci.rb.
require_relative "../config/boot"
require "active_support/continuous_integration"

# Rails 8.1.4 appelle `colorize(:error, texte)` dans le message de Ctrl-C, les
# arguments à l'envers : une interruption finissait sur un KeyError au lieu de
# « ❌ … interrupted ». À retirer quand Rails l'aura corrigé.
class CI < ActiveSupport::ContinuousIntegration
  private

  def colorize(text, type)
    text, type = type, text if text.is_a?(Symbol)
    super
  end
end

require_relative "../config/ci"
