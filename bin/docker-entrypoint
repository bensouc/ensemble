#!/bin/bash -e

# Entrypoint du conteneur.
#
# Les jobs (Solid Queue) tournent DANS Puma en production : un seul conteneur
# suffit. Comme Coolify n'offre pas de "Start Command" pour les apps
# Dockerfile, PROCESS_TYPE garde la possibilité d'un conteneur dédié :
#   - PROCESS_TYPE=worker  -> bin/jobs (mettre alors SOLID_QUEUE_IN_PUMA=false
#                             sur l'app web)
#   - sinon (app web)      -> la commande par défaut du Dockerfile (Puma)
#
# Les migrations ne sont PAS lancées ici : elles tourneront via une commande
# pre-deploy Coolify, sur l'app WEB uniquement, pour ne s'exécuter qu'une fois.

if [ "${PROCESS_TYPE}" = "worker" ]; then
  exec bin/jobs
fi

exec "${@}"
