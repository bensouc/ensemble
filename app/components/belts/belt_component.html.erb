<%# Toute ceinture s'ouvre sur les compétences de la suivante. Seuls les domaines
    spéciaux ouvraient une modale, celle de leurs compétences acquises : elles
    y sont toujours, cochées. %>
<%= link_to edit_mobile_student_domain_validation_path(@belt.student, @domain),
      id: helpers.tuile_ceinture_id(@belt.student, @domain),
      class: "--width-5_7 m-2 mobile-ceinture-tuile#{' --obtenue' if @obtenue}",
      aria: { label: "#{@domain.name} : valider les compétences de la ceinture suivante" },
      data: { turbo_frame: "general_modal" } do %>
	<div class="mobile-belt-bar belt-bg-<%= @belt.level %>">
		<div class="bar-style --grisF">
			<%= I18n.l(@belt.validated_date, format: :short) %>
			<%= I18n.l(@belt.validated_date, format: :year_only) %>
		</div>
		<div class='pt-2 belt-name text-center --grisF'>
			<h6 <%= "class= text-light" if @belt.level == 7 || @belt.level == 5 %>><%= @domain.name %></h6>
		</div>
		<%= render 'mobile/belts/star' if @domain.special? %>
	</div>
<% end %>
