<%# Sans ceinture, l'appui ouvre les compétences de la blanche. %>
<%= link_to edit_mobile_student_domain_validation_path(@student, @domain),
      id: helpers.tuile_ceinture_id(@student, @domain),
      class: "--width-5_7 m-2 mobile-ceinture-tuile",
      aria: { label: "#{@domain.name} : valider les compétences de la ceinture blanche" },
      data: { turbo_frame: "general_modal" } do %>
	<div class="mobile-belt-bar belt-bg-1">
		<div class="bar-style">
			Aucune Ceinture
		</div>
		<div class='pt-2 belt-name text-center'>
			<h6 ><%= @domain.name %></h6>
		</div>
		<%= render 'mobile/belts/star' if @domain.special? %>
	</div>
<% end %>
