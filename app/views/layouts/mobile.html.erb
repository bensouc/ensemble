<!DOCTYPE html>
<html lang='fr'>
	<head>
		<%= favicon_link_tag %>
		<title><%= meta_title %></title>
		<%# PWA %>
		<link rel="manifest" crossorigin="use-credentials" href="<%= asset_path 'manifest.json' %>">
		<%= render 'shared/social_meta' %>
		<%= render 'shared/ios_pwa_links' %>
		<%= csrf_meta_tags %>
		<%= csp_meta_tag %>
		<!-- Hide url bar -->
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<!--Script & Style -->
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
		<%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
		<%# Font Awesome vient de `font-awesome-sass`, importé dans `application.scss`.
		    Le kit distant (kit.fontawesome.com) chargeait une SECONDE fois la même
		    version 6.7.2, en mode webfont : deux jeux de `@font-face` déclaraient
		    alors les mêmes familles — « Font Awesome 6 Free » en 400 et en 900 —, et
		    les moteurs ne résolvent pas ce doublon de la même façon. Sur iPhone, les
		    icônes pleines sortaient dessinées au trait, c'est-à-dire servies par la
		    fonte « Regular » à la place de la « Solid ». Un seul Font Awesome, servi
		    depuis notre domaine : les icônes sont aussi disponibles hors connexion,
		    ce que réclame une application qui s'installe. %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
	</head>
	<body>
		<%= render "shared/flashes"%>
		<%= render "shared/sync_status" %>
		<%= render "shared/stale_notice" %>
		<%= turbo_frame_tag "general_modal" do%>
			<div class="modal" tabindex="-1" role="dialog">
				<div class="modal-dialog" role="document">
					<div class="modal-content">
						<div class="modal-header">
							<h5 class="modal-title">Modal title</h5>
							<button type="button" class="close" data-dismiss="modal" aria-label="Close">
								<span aria-hidden="true">&times;</span>
							</button>
						</div>
						<div class="modal-body">
							<p>Modal body text goes here.</p>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-primary">Save changes</button>
							<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
						</div>
					</div>
				</div>
			</div>
		<% end %>
		<% if ["devise/registrations", "devise/sessions", "devise/passwords"].include?(params[:controller]) %>
			<%= yield %>
		<% else %>
			<div class="pastouche" style="margin: 0 auto" >
				<%= yield %>
			</div>
		</div>
		<%= render "shared/mobile_footer" %>
	<% end %>
</body>
</html>
