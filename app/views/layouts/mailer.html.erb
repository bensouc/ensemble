<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<style>
			/* Les clients mail ignorent la plupart des feuilles de style : tout ce qui
			   compte est répété en attribut `style` dans les gabarits. Ce bloc ne sert
			   qu'à ce qui ne peut pas l'être — la marge du body, et le rendu des liens
			   sur les clients qui les recolorent d'office. */
			body { margin: 0 !important; padding: 0 !important; background-color: #f5f5f7; }
			a { color: #f24150; }
			@media only screen and (max-width: 620px) {
				.mail-card { width: 100% !important; }
				.mail-pad { padding-left: 24px !important; padding-right: 24px !important; }
			}
		</style>
	</head>

	<body style="margin:0; padding:0; background-color:#f5f5f7;">
		<%= yield %>
	</body>
</html>
