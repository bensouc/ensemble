<!doctype html>
<html>
	<head>
		<meta charset='utf-8' />
		<!-- Bootstrap CSS (local) -->
		<style>
			<%# Lues dans les chemins de Propshaft, en dev comme en production : la
			    feuille construite (app/assets/builds) est dans l'image. Ses
			    `url(...woff2)` restent brutes, PdfGenerator les remplace par les
			    polices en base64. %>
			<%= raw Rails.application.assets.load_path.find("bootstrap-pdf.min.css").content(encoding: "UTF-8") %>
		</style>
		<title><%= @title%></title>
		<style>
			<%= raw Rails.application.assets.load_path.find("pdf.css").content(encoding: "UTF-8") %>
		</style>
		<meta http-equiv="content-type" content="text/html; charset=utf-8" />
	</head>
	<body>
		<%= yield %>
	</body>
</html>
