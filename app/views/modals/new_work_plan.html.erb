<%= turbo_frame_tag "general_modal" do %>
	<div class="modal-ensemble" data-controller="modals">
		<%# Un seul formulaire, deux boutons : `formaction` envoie l'un vers la création
		    d'un plan vierge, l'autre vers la génération automatique. Le nom et la
		    période saisis servent dans les deux cas.
		    `turbo: false` : les deux chemins répondent par une redirection vers le plan
		    créé, qui doit charger la page entière et non le contenu de cette frame.
		    `authenticity_token` : le jeton de session, valable partout. Celui que Rails
		    pose d'office ne vaut que pour l'`action` du formulaire, et `formaction`
		    envoie le second bouton ailleurs : la génération auto serait refusée.
		    Le rouage tourne dans le bouton choisi le temps que le serveur crée le
		    plan — quelques secondes pour la génération auto. Des `button` et non des
		    `input` : un `input` ne peut rien contenir, pas même un rouage. %>
		<%= simple_form_for @work_plan,
		                    url: work_plans_path,
		                    method: :post,
		                    authenticity_token: form_authenticity_token,
		                    html: { novalidate: false, class: "wp-edit-form",
		                            data: { turbo: false, controller: "loadingspinnermgnt domaines-auto",
		                                    action: "submit->loadingspinnermgnt#tournerPendantEnvoi " \
		                                            "pageshow@window->loadingspinnermgnt#reinitialiserAuRetour" } } do |f| %>
			<div class="modal-ensemble-dialog">
				<div class="modal-ensemble-content">
					<div class="modal-ensemble-header">
						<h5 class="modal-title">
							Nouveau plan de travail pour <%= @student.first_name.capitalize %>
						</h5>
						<button type="button" class="btn-close" aria-label="Fermer"
						        data-action="click->modals#emptyModal"></button>
					</div>
					<div class="modal-body">
						<%= f.hidden_field :student_id %>
						<%= f.hidden_field :grade_id %>
						<%= f.input :name, label: "Nom du plan de travail",
                        required: :true,
                        wrapper_html: { class: 'wp-edit-full-row' },
                        input_html: { class: 'area' } %>
						<%= f.input :start_date, as: :string, label: "Du",
                        required: :true,
                        input_html: { class: 'datepicker area', locale: "fr",
                                      value: @work_plan.start_date.strftime("%d/%m/%Y") } %>
						<%= f.input :end_date, as: :string, label: "Au",
                        required: :true,
                        input_html: { class: 'datepicker area', locale: "fr",
                                      value: @work_plan.end_date.strftime("%d/%m/%Y") } %>
						<%# Repliée jusqu'au choix de la génération auto. Les noms `student[domains][]`
						    sont ceux de la modale des résultats de classe : `auto_new_wp` les lit
						    déjà, et le champ vide en tête permet de tout décocher. %>
						<fieldset class="wp-new-domains wp-edit-full-row" hidden disabled
						          data-domaines-auto-target="domaines">
							<legend>Domaines à générer</legend>
							<%= hidden_field_tag "student[domains][]", "", id: nil %>
							<% @domains.each do |domain| %>
								<span class="tag-item">
									<%= check_box_tag "student[domains][]", domain.id, @checked_domains.include?(domain),
									                  id: "wp_new_domain_#{domain.id}", class: "tag-selector" %>
									<%= label_tag "wp_new_domain_#{domain.id}", domain.name %>
								</span>
							<% end %>
						</fieldset>
					</div>
					<div class="modal-ensemble-footer wp-new-actions">
						<p class="wp-new-hint">
							<em>Un plan auto-généré reprend les ceintures et résultats de
								<%= @student.first_name.capitalize %>.</em>
						</p>
						<div class="d-flex">
							<%= f.button :button, "Plan vierge", class: "utility-wp-btn" %>
							<%= f.button :button, "Auto, selon son niveau",
							             class: "utility-wp-btn utility-wp-btn--primary",
							             formaction: student_auto_new_wp_path(@student),
							             data: { action: "click->domaines-auto#deplier" } %>
						</div>
					</div>
				</div>
			</div>
		<% end %>
	</div>
<% end %>
