<%= turbo_frame_tag "general_modal" do %>
	<div class="modal-ensemble" data-controller="modals">
		<%# La modale du nouveau plan de travail, réduite au choix des domaines. La
		    fiche préparée s'ouvre à la place de la page (`_top`) : c'est elle qu'on
		    vient régler. Le champ vide en tête permet de tout décocher. %>
		<%= form_with url: student_belt_sheets_path(@student), method: :post,
		              class: "wp-edit-form", data: { turbo_frame: "_top" } do %>
			<div class="modal-ensemble-dialog">
				<div class="modal-ensemble-content modal-domaines">
					<div class="modal-ensemble-header">
						<h5 class="modal-title">
							Nouvelle fiche de ceinture pour <%= @student.first_name.capitalize %>
						</h5>
						<%= render Ui::ButtonComponent.new(variant: :icon, icon: "fa-xmark", title: "Fermer", html: { class: "ms-auto" }, data: { action: "click->modals#emptyModal" }) %>
					</div>
					<div class="modal-body">
						<fieldset class="wp-new-domains wp-edit-full-row">
							<legend>Domaines de la fiche</legend>
							<%= hidden_field_tag "belt_sheet[domain_ids][]", "", id: nil %>
							<div class="domain-choice">
								<% @domains.each do |domain| %>
									<span class="tag-item">
										<%= check_box_tag "belt_sheet[domain_ids][]", domain.id, @checked_domains.include?(domain),
										                  id: "belt_sheet_domain_#{domain.id}", class: "tag-selector" %>
										<%= label_tag "belt_sheet_domain_#{domain.id}" do %>
											<%= domain.name %>
											<% if @en_cours[domain] %>
												<small class="ms-1">· <%= @en_cours[domain] %> en cours</small>
											<% end %>
										<% end %>
									</span>
								<% end %>
							</div>
						</fieldset>
					</div>
					<div class="modal-ensemble-footer wp-new-actions">
						<p class="wp-new-hint">
							<em><strong>Ceintures en cours</strong> : les compétences posées « ceinture » dans un plan
								de travail, pas encore passées. <strong>Selon les résultats</strong> : pour chaque domaine,
								la ceinture qui suit la dernière validée par <%= @student.first_name.capitalize %>.</em>
						</p>
						<%# Deux boutons, un même formulaire : `mode` dit comment préparer. %>
						<div class="d-flex gap-2">
							<%= render Ui::ButtonComponent.new("Annuler", variant: :neutral, data: { action: "click->modals#emptyModal" }) %>
							<%= render Ui::ButtonComponent.new("Selon les résultats", type: "submit",
							                                   html: { name: "mode", value: "resultats" }) %>
							<%= render Ui::ButtonComponent.new("Ceintures en cours", variant: :primary, type: "submit",
							                                   html: { name: "mode", value: "en_cours" }) %>
						</div>
					</div>
				</div>
			</div>
		<% end %>
	</div>
<% end %>
