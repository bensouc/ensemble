<div class="main_nav">
	<%= link_to dashboard_path,class:"logo"  do %>
		<% if user_signed_in? && current_user.demo %>
			<%= image_tag "logo_demo.png", alt: "logo demo" %>
		<% else %>
			<img
        src="https://res.cloudinary.com/dr50qe2fh/image/upload/v1638453284/LOGO_lesptr.svg"
        alt="Logo">
			<% end %>
		<% end %>
		<div class="menu-g">
			<% if user_signed_in? %>
				<div class="menug-container">
					<div class="link-container" data-controller="leftmenulinks">
						<%# « Voir » n'est pas un lien : il ouvre ou replie son sous-menu. %>
						<div data-action="click->leftmenulinks#toggleDisplayLinks" role="button">
							<%= render "shared/nav_entree", libelle: "Voir", actif: section_voir.present?,
							           icone: "https://res.cloudinary.com/dr50qe2fh/image/upload/v1638459822/ico_menu_1_wvddvx.svg" %>
						</div>
						<%# Ouvert tant qu'on est dans une page de « Voir », l'entrée courante
						    marquée ; le clic sur « Voir » le replie ou le déplie. %>
						<div class="nav-left-sub-links <%= "d-none" unless section_voir %>" data-leftmenulinks-target="links">
							<% entrees = [[:plans, "Plans de travail", work_plans_path]]
							   entrees << [:ceintures, "Ceintures", belt_sheets_path] if fiches_de_ceinture_ouvertes?
							   entrees << [:progressions, "Mes compétences", skills_path] %>
							<% entrees.each do |section, libelle, chemin| %>
								<%= link_to chemin, aria: { current: ("page" if section_voir == section) } do %>
									<p class="sub-link <%= "sub-link--active" if section_voir == section %>"><%= libelle %></p>
								<% end %>
							<% end %>
						</div>
					</div>
					<%= link_to new_work_plan_path do %>
						<%= render "shared/nav_entree", libelle: "Créer",
						           actif: current_page?(new_work_plan_path) || (action_name == "show" && controller_name == "work_plans"),
						           icone: "https://res.cloudinary.com/dr50qe2fh/image/upload/v1638798743/2_ekrwe3.svg" %>
					<% end %>
					<%= link_to classrooms_path do %>
						<%= render "shared/nav_entree",
						           libelle: current_user.classrooms.count + current_user.user_shared_classrooms.count < 2 ? "Ma Classe" : "Mes Classes",
						           actif: current_page?(classrooms_path) || controller_name == "students",
						           icone: "icons/eval-red-icon.svg" %>
					<% end %>
					<%# Son libellé s'allumait sur les pages de Créer : il en recopiait la
					    condition. %>
					<%= link_to conversations_path do %>
						<%= render "shared/nav_entree", libelle: "Partager", actif: controller_name == "conversations",
						           icone: "btns/share_rose_white.png" %>
					<% end %>
					<%# Manipule est une option : sans elle, l'entrée n'existe pas. Son icône,
					    fa-cubes-stacked figée en SVG, est servie depuis le dépôt et non
					    Cloudinary, dont le compte est partagé avec la production. %>
					<% if current_user.manipule_ouvert? %>
						<%= link_to manipule_root_path do %>
							<%= render "shared/nav_entree", libelle: "Manipule", actif: controller_path.start_with?("manipule"),
							           icone: "icons/manipule-red-icon.svg", extra: tag.span("bêta", class: "beta") %>
						<% end %>
					<% end %>
				</div>
				<% end %>
			</div>
			<div class="calendrier">
				<h3><%= I18n.l(Date.today, format: :long) %>
				</h3>
				<h4>Semaine
					<%= Date.today.strftime("%W").to_i %></h4>
				<br>
				<p>du :
					<%= Date.today.at_beginning_of_week.strftime("%d/%m/%Y") %><br>
					au :
					<%= ((Date.today.at_end_of_week) - 2).strftime("%d/%m/%Y") %></p>
			</div>
			<div class="deco ">
				<%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item d-flex" do %>
					<i class="fas fa-sign-out-alt"></i>
					<h6>Se déconnecter</h6>
				<% end %>
			</div>
		</div>
