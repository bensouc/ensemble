<%# Remplace le turbo-frame du layout : la modale n'existe qu'après le clic. %>
<%= turbo_frame_tag "general_modal" do %>
  <div class="modal-ensemble" data-controller="modals">
    <div class="modal-ensemble-dialog">
      <div class="modal-ensemble-content">
        <div class="modal-ensemble-header">
          <h5 class="modal-title">Changer <%= @student.first_name %> de classe</h5>
          <button type="button" class="btn-close" aria-label="Fermer" data-action="click->modals#emptyModal"></button>
        </div>
        <div class="modal-body">
          <%= render "form", student: @student, target_classrooms: @target_classrooms %>
        </div>
      </div>
    </div>
  </div>
<% end %>
