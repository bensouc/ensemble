<%# Notification interne : elle sert à traiter la demande, pas à séduire. Les
    champs sont donc lisibles d'un coup d'œil. %>
<h1 style="<%= mail_style(:titre) %>">Nouveau contact</h1>

<%= mail_field("Nom", "#{@contact[:first_name]} #{@contact[:last_name]}".strip) %>
<%= mail_field("Email", @contact[:email]) %>
<%= mail_field("École", @contact[:school]) %>
<%= mail_field("Ville", @contact[:city]) %>
<%= mail_field("Découvert par", @contact[:discovery_method]) %>
<%= mail_field("Message", @contact[:message]) %>
