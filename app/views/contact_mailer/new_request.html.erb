<h1 style="<%= mail_style(:titre) %>">Nouvelle demande</h1>

<%= mail_field("Type de demande", @user_request[:type]) %>
<%= mail_field("Nom", "#{@user_request[:first_name]} #{@user_request[:last_name]}".strip) %>
<%= mail_field("Email", @user_request[:email]) %>
<%= mail_field("École", @user_request[:school]) %>
<%= mail_field("Ville", @user_request[:city]) %>
<%= mail_field("Message", @user_request[:message]) %>
