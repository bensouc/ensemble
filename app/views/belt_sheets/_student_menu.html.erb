<% fiches = student.belt_sheets.order(created_at: :desc).limit(10) %>
<div class="dropdown belt-sheet-menu">
	<%# L'infobulle de Bootstrap, à droite comme celle du bouton de génération : la
	    bulle native du navigateur s'ouvrait par-dessus lui. Elle vit sur l'icône,
	    le bouton portant déjà `data-bs-toggle="dropdown"` — et Bootstrap cherche le
	    menu à côté de lui, il ne faut pas l'envelopper. %>
	<button type="button" class="--bgc-blanc border-0 p-0" data-bs-toggle="dropdown" aria-expanded="false"
	        aria-label="Fiches de ceinture">
		<i class="fas fa-bacon printer-logo ms-4" data-controller="tooltip" data-bs-placement="right"
		   title="Fiches de ceinture"></i>
	</button>
	<ul class="dropdown-menu">
		<li>
			<%= link_to student_new_belt_sheet_modal_path(student), class: "dropdown-item",
			            data: { turbo_frame: "general_modal" } do %>
				<i class="fa-solid fa-circle-plus me-2"></i>Nouvelle fiche de ceinture
			<% end %>
		</li>
		<% if fiches.any? %>
			<li><hr class="dropdown-divider"></li>
			<% fiches.each do |fiche| %>
				<li>
					<%= link_to belt_sheet_path(fiche), class: "dropdown-item", data: { turbo_frame: "_top" } do %>
						Fiche du <%= l(fiche.created_at.to_date) %>
					<% end %>
				</li>
			<% end %>
		<% end %>
	</ul>
</div>
