<%# L'éditeur de fiche de ceinture : celui du plan de travail, sans le type —
    toute ligne d'une fiche est une ceinture. %>
<div class="pt --center-content belt-sheet">
	<div class="belt-sheet-header">
		<div>
			<h1 class="wp-title">Fiche de ceinture — <%= @belt_sheet.student.first_name %></h1>
			<h4 class="date-domain">Préparée le <%= l(@belt_sheet.created_at.to_date, format: :long) %></h4>
		</div>
		<div class="belt-sheet-actions">
			<%= render Ui::ButtonComponent.new("Progression", icon: "fa-arrow-left", href: student_path(@belt_sheet.student),
			                                   title: "Revenir à la progression de l'élève") %>
			<%# Un nouvel onglet : la page d'attente s'y affiche, puis le PDF. %>
			<%= render Ui::ButtonComponent.new("PDF", variant: :primary, icon: "fa-file-pdf",
			                                   href: export_belt_sheet_path(@belt_sheet),
			                                   html: { target: "_blank", rel: "noopener" }) %>
			<%= render Ui::ButtonComponent.new("Supprimer", variant: :neutral, icon: "fa-trash-can",
			                                   url: belt_sheet_path(@belt_sheet), method: :delete,
			                                   form: { data: { turbo_confirm: "Supprimer cette fiche de ceinture ?" } }) %>
		</div>
	</div>

	<div id="belt_sheet_domains">
		<%= render "belt_sheet_domains/list", belt_sheet: @belt_sheet %>
	</div>

	<%= render "belt_sheet_domains/add_link", belt_sheet: @belt_sheet %>
</div>
