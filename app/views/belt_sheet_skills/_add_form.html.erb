<% options = options_competences_fiche(bloc) %>
<% if options.present? %>
	<div data-controller="skill-add" class="pt-3">
		<div data-skill-add-target="button" data-action="click->skill-add#displayForm" class="add-item-btn">
			<i class="fa-solid fa-circle-plus"></i>
			<h6>Ajouter une compétence</h6>
		</div>
		<div class="d-none" data-skill-add-target="form">
			<%= form_with url: belt_sheet_domain_belt_sheet_skills_path(bloc), method: :post, class: "d-flex" do %>
				<div class="d-flex justify-content-between pb-1">
					<%= select_tag :skill_id, options, prompt: "Sélectionnez une compétence",
					               class: "skill-selector", required: true %>
				</div>
				<div class="d-flex">
					<%= submit_tag "Valider", class: "add-skill-btn" %>
					<div class="cancel-btn ms-3" data-action="click->skill-add#displayForm" style="margin-top: 10px">
						<i class="fas fa-times"></i>
					</div>
				</div>
			<% end %>
		</div>
	</div>
<% end %>
