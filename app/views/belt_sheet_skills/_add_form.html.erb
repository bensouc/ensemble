<% options = options_competences_fiche(bloc) %>
<% if options.present? %>
	<div data-controller="skill-add" class="pt-3">
		<div data-skill-add-target="button" data-action="click->skill-add#displayForm" class="add-item-btn">
			<i class="fa-solid fa-circle-plus"></i>
			<h6>Ajouter une compétence</h6>
		</div>
		<div class="d-none" data-skill-add-target="form">
			<%# Une seule ligne, centrée : le select et les deux boutons n'ont pas la même
			    hauteur, et une marge sur l'un les décalait. %>
			<%= form_with url: belt_sheet_domain_belt_sheet_skills_path(bloc), method: :post,
			              class: "d-flex align-items-center flex-wrap gap-2 mt-2" do %>
				<%= select_tag :skill_id, options, prompt: "Sélectionnez une compétence",
				               class: "skill-selector m-0", required: true %>
				<%= render Ui::ButtonComponent.new("Annuler", variant: :neutral,
				                                   data: { action: "click->skill-add#displayForm" }) %>
				<%= render Ui::ButtonComponent.new("Valider", variant: :primary, type: "submit") %>
			<% end %>
		</div>
	</div>
<% end %>
