<%# Choisir un domaine, et lui seul : sa ceinture est celle qui suit la dernière
    que l'élève a validée — la blanche pour un domaine spécial. Chaque pastille
    en porte l'icône, à sa couleur ; un domaine dont il a déjà la noire est
    grisé. Le même choix en pastilles que l'ajout d'un domaine à un plan. %>
<%= turbo_frame_tag :new_belt_sheet_domain do %>
	<div class="add-domain">
		<div class="add-domain-form">
			<%= form_with url: belt_sheet_belt_sheet_domains_path(@belt_sheet), method: :post do %>
				<div class="ui-step">
					<div class="ui-step-title">
						<span class="ui-step-num">1</span>Domaine
						<small>— sa ceinture est celle qui suit la dernière validée</small>
					</div>
					<div class="ui-chips">
						<% @domains.each do |domain| %>
							<% niveau = @ceintures[domain] %>
							<%= render Ui::ChoiceChipComponent.new(name: "belt_sheet_domain[domain_id]", value: domain.id,
							                                       label: domain.name, belt: niveau || Belt::BELT_COLORS.size,
							                                       hint: ("toutes validées" unless niveau),
							                                       disabled: niveau.nil?) %>
						<% end %>
					</div>
				</div>
				<div class="box-end gap-2">
					<%= render Ui::ButtonComponent.new("Annuler", variant: :neutral, href: belt_sheet_path(@belt_sheet),
					                                   data: { turbo_frame: "_top" }) %>
					<%= render Ui::ButtonComponent.new("Ajouter", variant: :primary, type: "submit") %>
				</div>
			<% end %>
		</div>
	</div>
<% end %>
