<%# Les deux seules actions possibles vivent DANS l'encart : pas de colonne de CTA
    à droite, et surtout pas le « Charger » de `challenges/_mngt` ni le « Cloner »
    (il n'y a rien à cloner). %>
<% loadable = Challenge.classic.where(skill: work_plan_skill.skill).exists? %>
<div class="challenge-card empty-challenge">
	<div class="empty-challenge-msg">
		<div class="empty-challenge-text">
			<i class="fa-regular fa-file-lines"></i>
			<p>
				<% if loadable %>
					Cet élève a déjà eu tous les exercices de cette compétence.
				<% else %>
					Aucun exercice n'existe encore pour cette compétence.
				<% end %>
			</p>
		</div>
		<div class="empty-challenge-actions">
			<% if loadable %>
				<%= button_to work_plan_skill_pick_challenge_path(work_plan_skill),
				              class: "empty-challenge-btn" do %>
					<i class="far fa-folder-open"></i>
					<span>Charger un exercice existant</span>
				<% end %>
			<% end %>
			<%= button_to work_plan_skill_create_empty_challenge_path(work_plan_skill),
			              class: "empty-challenge-btn" do %>
				<i class="fa-solid fa-plus"></i>
				<span>Créer un nouveau</span>
			<% end %>
		</div>
	</div>
</div>
