<%#
  Fenêtre d'annonce du tableau de bord : même cadre que le guide « Bien
  commencer avec Ensemble » (dashboard/_advice_modal). « Plus tard » la remet
  au lendemain ; « Ne plus afficher » l'écarte pour de bon (Annonce). La croix
  la ferme pour cette visite seulement.
%>
<dialog id="myModal" class="annonce" open aria-labelledby="annonce-titre">
	<div class="modal-content annonce__contenu">
		<form method="dialog" class="mb-3">
			<div class="closing-btn d-flex justify-content-between align-items-center">
				<%= image_tag 'logo_demo.png' if current_user.demo? %>
				<%= image_tag 'https://res.cloudinary.com/dr50qe2fh/image/upload/v1638453284/LOGO_lesptr.svg' unless current_user.demo? %>
				<h4 id="annonce-titre" class="--roseL"><%= annonce.titre %></h4>
				<button class="--bgc-transparent" aria-label="Fermer">
					<h3 class="--roseL --cursor-pointer"><i class="fa-solid fa-circle-xmark"></i></h3>
				</button>
			</div>
		</form>

		<%= render annonce.partial %>

		<div class="annonce__actions">
			<%= render Ui::ButtonComponent.new("Plus tard", variant: :neutral,
			                                   url: reporter_annonce_path(annonce.id), method: :patch) %>
			<%= render Ui::ButtonComponent.new("Ne plus afficher", variant: :primary,
			                                   url: masquer_annonce_path(annonce.id), method: :patch) %>
		</div>
	</div>
</dialog>
