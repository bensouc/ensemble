<div class="mobile_index ">
  <nav class='mobile-eval-header'>
    <%# Retour à la liste, avec l'élève désigné : on ne quittait cet écran qu'en
        revenant en arrière dans le navigateur, ce qui n'existe pas dans une PWA
        installée — il n'y a plus de barre. %>
    <%= link_to mobile_work_plans_path(eleve: @work_plan.student_id),
                class: "mobile-retour", "aria-label": "Retour aux plans de travail" do %>
      <i class="fa-solid fa-chevron-left"></i>
      <span>Plans de travail</span>
    <% end %>
    <div class=' mobile-eval-header-details'>
      <div class= 'first-name'>
        <h6 class="mobile-wp-dates">
          <%= @work_plan.start_date.nil? ? "" : l(@work_plan.start_date, format: "%d/%m/%Y") %>
          <%= @work_plan.end_date.nil? ? "" : l(@work_plan.end_date, format: "%d/%m/%Y") %>
        </h6>
        <h4><%=@work_plan.student.first_name %></h4>
      </div>
      <div class="title d-flex flex-column ">
        <h3 class=""><%=@work_plan.name %> </h3>
        <p>Niveau :<%= @work_plan.grade.grade_level%></p>
      </div>
    </div>
    <%# <div class="greyline-mobile"></div> %>
  </nav>
  <%= render "shared/mobile_intro",
             texte: "Touchez une compétence pour enregistrer son évaluation." %>
  <div class="mobile-eval-wp" data-controller="display-right-anchor">
    <%= render "eval_mobile_work_plan_domains", work_plan: @work_plan, domains: @domains %>
  </div>
</div>
