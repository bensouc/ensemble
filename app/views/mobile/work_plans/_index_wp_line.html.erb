<%# Un plan de travail : son nom et sa période. La carte entière ouvre
    l'évaluation. %>
<%= link_to mobile_evaluation_path(wp), class: "mobile-index-wp-card" do %>
  <span class="mobile-namept"><%= wp.name %></span>
  <span class="mobile-wp-dates">
    <%= wp.start_date.nil? ? "" : l(wp.start_date, format: "%d/%m/%Y") %>
    <%= wp.end_date.nil? ? "" : l(wp.end_date, format: "au %d/%m/%Y") %>
  </span>
<% end %>
