<div data-controller='toggle-panel'>
  <div class='domain  ' >
    <% # DOMAIN + BELT DISPLAY %>
    <div class="mobile-domain-level" data-action="click->toggle-panel#displayPanel">
      <div class='belt'>
        <div class='d-flex justify-content-around '>
          <div class='bd-maison' >
            <i class=" fas fa-bacon belt-<%= work_plan_domain.level %>  mobile-belt font-weight-bold"></i>
          </div>
        </div>
      </div>
      <h3><%= work_plan_domain.domain.name %></h3>
      <%# Rien ne disait que le domaine s'ouvrait : on tapait dessus pour voir.
          Le chevron est celui de la liste des plans de travail et de celle des
          classes — pointé à droite quand c'est fermé, vers le bas quand c'est
          ouvert. Les noms de cible viennent du contrôleur Stimulus, qui les
          bascule tous les deux. %>
      <i class="fa-solid fa-chevron-right --roseL mobile-domain-chevron"
         data-toggle-panel-target="btn" aria-hidden="true"></i>
      <i class="fa-solid fa-chevron-down --roseL mobile-domain-chevron d-none"
         data-toggle-panel-target="btn" aria-hidden="true"></i>
    </div>
  </div>
  <% # SKILLS DISPLAY %>
  <div class='mobile-skill-display d-none' id="<%= dom_id(work_plan_domain) %>" data-toggle-panel-target="panel">
    <% work_plan_domain.work_plan_skills.sort_by{|wps| wps.position}.each do |plan_skill| %>
      <%= render "eval_mobile_skill_display", plan_skill: plan_skill %>
    <% end %>
  </div>
</div>
