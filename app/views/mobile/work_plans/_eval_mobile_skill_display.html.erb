<% last_3_wps = @previous.find { |t| t.first == plan_skill.skill_id }[1].sort_by(&:created_at) %>
<div class="mobile-skill-card">
  <div class='title-mobile-skill-card'>
    <h3 class='me-2 mt-2'><%= plan_skill.skill.symbol %></h3>
    <h6 class ='mt-2 mb-2'style='text-align:left;margin-bottom: 0'><%= plan_skill.skill.name %></h6>
  </div>
  <div class="mobile-eval-display" data-controller='ajax-work-plan'
       data-ajax-work-plan-id-value='<%= plan_skill.id %>'>
    <div class="previous_eval mt-2">
      <% unless last_3_wps.count == 1 %>
        <% # 3 previous wps %>
        <% # last_wps = WorlPlanSkill %>
        <%last_3_wps.each do |wps|%>
          <% unless wps.id == plan_skill.id %>
            <%= render "shared/pastille_eval", statut: wps.status, lettre: lettre_nature(wps.kind) %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <%# Où en est la compétence, en toutes lettres, juste à gauche de sa pastille.

        La pastille ne le disait qu'en couleur et par son anneau. Le code se lit
        vite une fois appris, mais il s'apprend : le bureau le double d'une
        infobulle depuis toujours, et le téléphone, qui n'a pas de survol,
        n'avait rien. Le mot prend la place restée vide au milieu de la carte.

        `motEtat` est une cible de `ajax-work-plan` : le mot suit la peinture
        optimiste de la pastille, sans quoi il annoncerait le statut d'avant
        jusqu'à la réponse du serveur — et, hors ligne, jusqu'à la
        synchronisation. %>
    <span class="mobile-eval-etat" data-ajax-work-plan-target="motEtat"><%=
      libelle_evaluation(plan_skill.status, plan_skill.kind) %></span>
    <% # current wps %>
    <%# start of eval modal %>
    <%# Le bouton n'a pour tout contenu qu'un disque coloré : sans nom, un
        lecteur d'écran n'annonçait que « bouton ». %>
    <button type="button" class="bg-white" data-bs-toggle="modal" data-bs-target="#evalModal-<%= plan_skill.id%>"
            aria-label="Évaluer <%= plan_skill.skill.name %>">
      <div class= 'mobile-last-eval' data-ajax-work-plan-target='lastEval'>
        <%= render "shared/pastille_eval", statut: plan_skill.status, lettre: lettre_nature(plan_skill.kind) %>
      </div>
    </button>
    <%# MODAL  %>
    <div class="modal fade" id="evalModal-<%=plan_skill.id %>" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel"><%=plan_skill.skill.name%></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <%= render "eval_mobile_wps_mngt", plan_skill: plan_skill %>

          </div>
        </div>
      </div>
    </div>
  </div>
  <%# end of eval modal %>
</div>
