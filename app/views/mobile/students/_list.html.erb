<%= turbo_frame_tag("classroom_#{classroom.id}_list") do %>
	<%# `students.nil?` laissait une classe vide s'afficher sans un mot : une
	    collection vide n'est pas nil. %>
	<% if students.blank? %>
		<p class="mobile-eleve-vide">Cette classe n'a pas encore d'élève.</p>
	<% else %>
		<% students.each do |student| %>
			<%= turbo_frame_tag(student) do %>
				<%= link_to mobile_classroom_student_path(classroom, student), class: "mobile-eleve-ligne" do %>
					<span class="mobile-eleve-prenom"><%= student.first_name.capitalize %></span>
					<i class="fa-solid fa-chevron-right --roseL"></i>
				<% end %>
			<% end %>
		<% end %>
	<% end %>
<% end %>
