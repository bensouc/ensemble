<% last_3_wps = @previous.find { |t| t.first == plan_skill.skill_id }[1].sort_by(&:created_at) %>
<%# La ligne d'une compétence, dans l'ordre où on l'évalue : ce que c'est, où
    l'élève en est, ce qu'on décide.

    Elle donnait l'inverse — le passé, puis les boutons, puis le libellé tout au
    bout —, si bien que l'œil partait à droite, revenait au milieu, puis
    cliquait : trois arrêts par compétence, sur un plan de travail entier. Le
    libellé passe donc devant et prend toute la largeur disponible, et le geste
    se trouve au bout, là où va la main.

    Entre les deux, l'état : les évaluations précédentes, puis celle du jour,
    séparée d'un trait. C'est le rappel qui dit où on en est sans avoir à
    chercher quelle case du contrôle porte le cadre. %>
<div class='eval-ligne' data-controller='ajax-work-plan' data-ajax-work-plan-id-value='<%= plan_skill.id %>'>
  <div class='eval-libelle'>
    <%= plan_skill.skill.symbol %>
    <%= plan_skill.skill.name %>
  </div>
  <div class="eval-etat">
    <div class="eval-passe">
      <% last_3_wps.each do |wps| %>
        <% unless wps.id == plan_skill.id %>
          <%= render "shared/pastille_eval", statut: wps.status, lettre: lettre_nature(wps.kind),
                                            titre: libelle_evaluation(wps.status, wps.kind) %>
        <% end %>
      <% end %>
    </div>
    <div class="eval-courant" data-ajax-work-plan-target='lastEval'>
      <%= render "shared/pastille_eval", statut: plan_skill.status, lettre: lettre_nature(plan_skill.kind),
                                        titre: libelle_evaluation(plan_skill.status, plan_skill.kind) %>
    </div>
  </div>
  <%= render "eval_controle", plan_skill: plan_skill %>
</div>
