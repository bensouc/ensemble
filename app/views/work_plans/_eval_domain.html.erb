<div class='domain  ' id="<%= dom_id(work_plan_domain) %>">
	<%# Le nom du domaine logeait dans la colonne de la ceinture, large de 100px,
	    en se donnant une largeur propre de 700px : il en débordait par la
	    droite, au-dessus des compétences. Les 46px de marge haute de la colonne
	    voisine lui dégageaient une bande — un contournement qui cédait dès que
	    la ligne d'une compétence grandissait. Il a maintenant sa propre ligne. %>
	<div class='eval-domain-titre'><%= work_plan_domain.domain.name %></div>
	<% # BELT DISPLAY %>
	<div class='p-1 d-flex'>
		<div class='eval-domain-belt-level'>
			<div >
				<div class='d-flex justify-content-around belt-display'>
					<div class='bd-maison' >
						<i class=" fas fa-bacon belt-<%= work_plan_domain.level %> display-2 font-weight-bold"></i>
					</div>
				</div>
				<div class='d-flex justify-content-around mt-1 belt-display' <% if work_plan_domain.domain.special? %> style = 'visibility: hidden'<% end %> >
					<strong><%= Belt::BELT_COLORS[work_plan_domain.level - 1].capitalize %></strong>
				</div>
			</div>
		</div>
		<% # SKILLS DISPLAY %>
		<div class='p-2 eval-skills'>
			<% work_plan_domain.work_plan_skills.sort_by{|wps| wps.position}.each do |plan_skill| %>
				<%= render "eval_skill_display", plan_skill: plan_skill %>
			<% end %>
		</div>
	</div>
	<%# raise %>
</div>
