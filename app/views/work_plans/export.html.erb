<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <title>Génération du plan de travail…</title>
    <%# Page autonome : ni layout, ni feuille de style de l'app. Elle doit s'afficher
        instantanément, c'est toute sa raison d'être. %>
    <style>
      body {
        display: flex; align-items: center; justify-content: center;
        height: 100vh; margin: 0;
        font-family: "Poppins", system-ui, sans-serif; color: #3D3D3D;
        background: #FFFFFF;
      }
      .wait { text-align: center; }
      .wait__spinner {
        width: 46px; height: 46px; margin: 0 auto 18px;
        border: 4px solid rgba(242, 65, 80, 0.18);
        border-top-color: #F24150; border-radius: 50%;
        animation: spin 0.9s linear infinite;
      }
      .wait__title { margin: 0 0 6px; font-size: 17px; font-weight: 600; }
      .wait__hint { margin: 0; font-size: 13px; color: #9C9C9C; }
      @keyframes spin { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) { .wait__spinner { animation-duration: 3s; } }
    </style>
  </head>
  <body>
    <div class="wait" role="status" aria-live="polite">
      <div class="wait__spinner"></div>
      <p class="wait__title">Génération du plan de travail…</p>
      <p class="wait__hint">Le PDF s'affichera dans cet onglet.</p>
    </div>

    <%# `replace` et pas `href` : la page d'attente ne laisse pas d'entrée dans
        l'historique de l'onglet, le bouton Retour ne peut donc pas y ramener et
        relancer une génération. %>
    <script>
      window.location.replace("<%= work_plan_path(@work_plan, format: :pdf) %>");
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url=<%= work_plan_path(@work_plan, format: :pdf) %>">
    </noscript>
  </body>
</html>
