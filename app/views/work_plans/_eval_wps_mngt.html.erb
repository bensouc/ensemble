<%# Les statuts d'évaluation du bureau.

    Libellés et icônes viennent de `EvaluationStatutsHelper`, partagé avec la
    modale du mobile : la même liste, dans le même ordre, avec les mêmes mots.
    Auparavant les deux partiels les recopiaient chacun de leur côté — et les
    exercices de type « jeu » n'avaient d'infobulle sur aucun des deux. %>
<div class="eval-mngt">
  <div>
    <% statuts_evaluation(plan_skill).each do |statut| %>
      <%= link_to work_plan_skill_eval_update_path(plan_skill, status: statut.statut),
                  title: statut.libelle,
                  data: { turbo_prefetch: false, action: "click->ajax-work-plan#toggle",
                          controller: "tooltip", bs_toggle: "tooltip", bs_placement: "top" } do %>
        <i class="<%= statut.icone %> <%= statut.couleur %> eval-icon"></i>
      <% end %>
    <% end %>
  </div>
</div>
