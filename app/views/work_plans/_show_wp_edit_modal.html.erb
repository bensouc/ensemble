<!-- Modal WP EDIT-->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="exampleModalLabel">Edition du Plan de Travail</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<%# Le formulaire enveloppe le corps ET le pied : sa balise de fermeture doit
			    donc rester à l'intérieur de `.modal-content`, ce qui n'était pas le cas. %>
			<%= simple_form_for work_plan,
			url: work_plan_path(work_plan),
			method: :patch,
			html: { novalidate: false, class: "wp-edit-form" } do |f|%>
				<%# Grille à deux colonnes : les quatre champs sont des éléments de la même
				    grille, leurs bords sont donc définis par les mêmes colonnes. Le nom et
				    l'élève occupent la largeur entière, les deux dates une colonne chacune.
				    Les champs étaient par ailleurs sans libellé : deux zones de texte
				    anonymes et une liste déroulante, impossible de savoir ce qu'on éditait. %>
				<div class="modal-body">
					<%= f.input :name, label: "Nom du plan de travail",
                      required: :true,
                      wrapper_html: { class: 'wp-edit-full-row' },
                      input_html: { class: 'area' } %>
					<%= f.input :start_date, as: :string, label: "Du",
                      required: :true,
                      input_html: {class: 'datepicker area', locale: "fr", value: work_plan.start_date.strftime("%d/%m/%Y") } %>
					<%= f.input :end_date, as: :string, label: "Au",
                      required: :true,
                      input_html: {class: 'datepicker area', locale: "fr", value: work_plan.end_date.strftime("%d/%m/%Y")} %>
					<%= f.association :student, label: "Élève",
                            collection: @students,
                            wrapper_html: { class: 'wp-edit-full-row' },
                            input_html: {class: 'area'},
                            label_method: :first_name %>
				</div>
				<div class="modal-footer">
					<%= f.submit "Valider", class: 'utility-wp-btn utility-wp-btn--primary',
					             data: {turbo_frame: "_top"} %>
				</div>
			<% end %>
		</div>
	</div>
</div>
