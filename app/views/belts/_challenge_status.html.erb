<% survol = { data: { action: "mouseover->wps-result#displayName mouseout->wps-result#hideName" } } %>
<%if wps.special_wps? %>
	<%= render "shared/pastille_eval", statut: wps.status, lettre: lettre_nature(wps.kind), attrs: survol %>
<% else %>
	<%= link_to work_plan_path(wps.work_plan_domain.work_plan), target: '_blank' do%>
		<%= render "shared/pastille_eval", statut: wps.status, lettre: lettre_nature(wps.kind), attrs: survol %>
	<% end %>
<% end %>
