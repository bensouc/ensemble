<%# La fiche de ceinture, sur le modèle des fiches papier : un bloc par domaine et
    ceinture, chacun sous son cartouche — une carte aux coins arrondis, comme
    l'énoncé du plan de travail : la ceinture à gauche, le domaine et sa couleur
    au centre, le prénom et la date à droite —, puis une bande grise par
    compétence, où l'enseignant marque au feutre si elle est acquise, et son
    énoncé.

    Mise en page : le plus de blocs possible par page, et un bloc n'est jamais
    coupé (`break-inside: avoid`). Un bloc plus haut qu'une page ne peut pas
    tenir : il ne se coupe alors qu'entre deux compétences, et son cartouche,
    porté par un `<thead>`, se répète en haut de la suite.

    Largeur de 1000 px, comme le plan de travail : Chrome la ramène à la page, et
    les énoncés rendent exactement comme dans le PDF du plan. %>
<style>
  body { height: auto; display: block; }
  .fiche { width: 976px; margin: 0 auto; font-family: "Poppins", sans-serif; color: #3D3D3D; }
  * { box-sizing: border-box; }
  .bloc { width: 100%; margin-bottom: 28px; border-collapse: collapse; break-inside: avoid; page-break-inside: avoid; }
  .bloc > thead td { padding-bottom: 10px; }
  .cartouche { display: flex; align-items: center; gap: 24px; padding: 12px 20px;
               border: 1.5px solid #3D3D3D; border-radius: 14px; }
  .cartouche .ceinture { width: 104px; height: auto; }
  .cartouche .titre { flex: 1; }
  .cartouche .domaine { font-size: 32px; font-weight: 700; line-height: 1.1; }
  .cartouche .couleur { display: inline-block; margin-top: 6px; padding: 2px 14px; border: 1.5px solid;
                        border-radius: 999px; font-size: 16px; font-weight: 600;
                        -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  /* La pastille à la couleur de la ceinture : un fond clair, un bord foncé —
     le jaune et le blanc se perdraient sur le papier. */
  .couleur--1 { background: #FFFFFF; border-color: #9C9C9C; }
  .couleur--2 { background: #FFF5B8; border-color: #B89600; }
  .couleur--3 { background: #FFE2B8; border-color: #D27C00; }
  .couleur--4 { background: #D3F2D5; border-color: #2E7D32; }
  .couleur--5 { background: #DCDBFA; border-color: #1E1BD3; }
  .couleur--6 { background: #F1DEC7; border-color: #8A4D00; }
  .couleur--7 { background: #E3E3E3; border-color: #000000; }
  .cartouche .eleve { width: 250px; padding-left: 20px; border-left: 1.5px solid #DDDDDD; font-size: 18px; }
  .cartouche .champ { display: flex; align-items: baseline; gap: 10px; min-height: 36px; padding: 4px 0; }
  .cartouche .champ + .champ { border-top: 1.5px solid #DDDDDD; }
  .cartouche .prenom { font-weight: 600; }
  .cartouche .libelle { width: 62px; font-size: 13px; color: #9C9C9C; text-transform: uppercase; letter-spacing: .06em; }
  .cartouche .date { font-weight: 600; letter-spacing: .3em; }
  .competence { break-inside: avoid; page-break-inside: avoid; }
  .bande { display: flex; align-items: center; gap: 10px; padding: 6px 8px 6px 14px;
           background: #DDDDDD; border-radius: 8px; font-size: 19px; font-weight: 700; }
  .bande img { width: 14px; height: 14px; }
  .bande .nom { flex: 1; }
  /* Assez grand pour la pointe d'un feutre : 6 mm une fois imprimé. Sans
     contour : le blanc se détache seul sur le gris de la bande. */
  .bande .marque { flex: none; width: 28px; height: 28px; border-radius: 50%; background: #FFFFFF; }
  /* Les règles de l'énoncé du PDF du plan de travail (`.cont-challenge`) : une
     largeur utile de 910 px, du Poppins à 20 px (`.enonce .trix-content`, dans pdf.scss), les images
     sur toute la largeur (`.challenge-content img`, partagée). */
  .enonce { padding: 12px 33px 20px; font-family: "Poppins", sans-serif; font-size: 20px; }
  .enonce .challenge-name-in-content { display: none; }
  .a-definir { color: #9C9C9C; font-style: italic; }
</style>
<div class="fiche">
	<%# Un bloc sans compétence — un domaine spécial pas encore garni — n'a rien à
	    imprimer. %>
	<% blocs.select { |bloc| bloc.belt_sheet_skills.any? }.each do |bloc| %>
		<table class="bloc">
			<thead>
				<tr>
					<td>
						<div class="cartouche">
							<%= image_tag(PdfGenerator.image_data_uri("belts/belt_#{bloc.level}.png"), alt: "", class: "ceinture") %>
							<div class="titre">
								<div class="domaine"><%= bloc.domain.name %></div>
								<span class="couleur couleur--<%= bloc.level %>">Ceinture <%= bloc.couleur %></span>
							</div>
							<div class="eleve">
								<%# Le prénom se lit sans libellé ; sans élève, il s'écrit à la
								    main, et le libellé dit quoi écrire. %>
								<div class="champ">
									<% if belt_sheet.student %>
										<span class="prenom"><%= belt_sheet.student.first_name.to_s.capitalize %></span>
									<% else %>
										<span class="libelle">Prénom</span>
									<% end %>
								</div>
								<div class="champ"><span class="libelle">Date</span><span class="date">/ &nbsp;&nbsp; /</span></div>
							</div>
						</div>
					</td>
				</tr>
			</thead>
			<tbody>
				<% bloc.belt_sheet_skills.each do |ligne| %>
					<tr class="competence">
						<td>
							<div class="bande">
								<% if ligne.skill.symbol_img_name.present? %>
									<%= image_tag(PdfGenerator.image_data_uri("symbols/#{ligne.skill.symbol_img_name}"), alt: "") %>
								<% end %>
								<span class="nom"><%= ligne.skill.name %></span>
								<span class="marque"></span>
							</div>
							<div class="enonce challenge-content">
								<% if ligne.challenge.nil? %>
									<p class="a-definir">Exercice de ceinture à définir</p>
								<% else %>
									<%= ligne.challenge.content.body %>
								<% end %>
							</div>
						</td>
					</tr>
				<% end %>
			</tbody>
		</table>
	<% end %>
</div>
