<%# La fiche de ceinture, sur le modèle des fiches papier : un bloc par domaine et
    ceinture, chacun sous son cartouche — une carte aux coins arrondis, comme
    l'énoncé du plan de travail : la ceinture à gauche, le domaine et sa couleur
    au centre, le prénom et la date à droite —, puis une bande grise par
    compétence, où l'enseignant marque au feutre si elle est acquise, et son
    énoncé.

    Mise en page : le plus de blocs possible par page, et un bloc n'est jamais
    coupé (`break-inside: avoid`). Un bloc plus haut qu'une page ne peut pas
    tenir : il ne se coupe alors qu'entre deux compétences, et son cartouche,
    porté par un `<thead>`, se répète en haut de la suite.

    Les règles de mise en page et les couleurs (la palette, jamais en dur) sont
    dans pdf_belt_sheets/_fiche.scss, que charge pdf.scss. %>
<div class="fiche">
	<%# Un bloc sans compétence — un domaine spécial pas encore garni — n'a rien à
	    imprimer. %>
	<% blocs.select { |bloc| bloc.belt_sheet_skills.any? }.each do |bloc| %>
		<table class="bloc">
			<thead>
				<tr>
					<td>
						<div class="cartouche">
							<%= image_tag(PdfGenerator.image_data_uri("belts/belt_#{bloc.level}.png"), alt: "", class: "ceinture") %>
							<div class="titre">
								<div class="domaine"><%= bloc.domain.name %></div>
								<span class="couleur couleur--<%= bloc.level %>">Ceinture <%= bloc.couleur %></span>
							</div>
							<div class="eleve">
								<%# Le prénom se lit sans libellé ; sans élève, il s'écrit à la
								    main, et le libellé dit quoi écrire. %>
								<div class="champ">
									<% if belt_sheet.student %>
										<span class="prenom"><%= belt_sheet.student.first_name.to_s.capitalize %></span>
									<% else %>
										<span class="libelle">Prénom</span>
									<% end %>
								</div>
								<div class="champ"><span class="libelle">Date</span><span class="date">/ &nbsp;&nbsp; /</span></div>
							</div>
						</div>
					</td>
				</tr>
			</thead>
			<tbody>
				<% bloc.belt_sheet_skills.each do |ligne| %>
					<tr class="competence">
						<td>
							<div class="bande">
								<% if ligne.skill.symbol_img_name.present? %>
									<%= image_tag(PdfGenerator.image_data_uri("symbols/#{ligne.skill.symbol_img_name}"), alt: "") %>
								<% end %>
								<span class="nom"><%= ligne.skill.name %></span>
								<span class="marque"></span>
							</div>
							<div class="enonce challenge-content">
								<% if ligne.challenge.nil? %>
									<p class="a-definir">Exercice de ceinture à définir</p>
								<% else %>
									<%= ligne.challenge.content.body %>
								<% end %>
							</div>
						</td>
					</tr>
				<% end %>
			</tbody>
		</table>
	<% end %>
</div>
