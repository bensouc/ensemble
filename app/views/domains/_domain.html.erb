<%=  turbo_frame_tag dom_id(domain), data:{id: domain.id} do%>
	<div class="domain-box" >
		<% if current_user.demo? %>
			<div class="--bgc-transparent p-0"
      data-controller="tooltip"
      data-bs-toggle="tooltip"
      data-bs-placement="top"
      title="Non disponible en Démo"
      >
				<i class="fas fa-pen fa-xs me-2" ></i>
			</div>
		<% else %>
			<%= link_to  edit_domain_path(domain) do%>
				<i class="fas fa-pen fa-xs me-2" ></i>
			<% end %>
		<% end %>
		<p class='grabbable'><%= domain.name %></p>
		<%# Préférence du professeur connecté, pas du domaine : un collègue n'en voit rien. %>
		<% if domain.auto_gen_for?(current_user) %>
			<%= button_to domain_auto_gen_exclusion_path(domain), method: :post,
			              class: "domain-auto-toggle",
			              title: "Inclus dans la génération automatique de vos plans de travail. Cliquer pour l'en sortir.",
			              aria: { label: "Sortir #{domain.name} de la génération automatique" } do %>
				<i class="fa-solid fa-user-gear"></i>
			<% end %>
		<% else %>
			<%= button_to domain_auto_gen_exclusion_path(domain), method: :delete,
			              class: "domain-auto-toggle domain-auto-toggle--off",
			              title: "Hors génération automatique : proposé décoché. Cliquer pour l'y remettre.",
			              aria: { label: "Remettre #{domain.name} dans la génération automatique" } do %>
				<i class="fa-solid fa-user-gear"></i>
			<% end %>
		<% end %>
		<% if current_user.demo? %>
			<div class="--bgc-transparent p-0"
      data-controller="tooltip"
      data-bs-toggle="tooltip"
      data-bs-placement="right"
      title="Non disponible en Démo"
      >
				<i class="fa-solid fa-circle-xmark ms-2"></i>
			</div>
		<% else %>
			<%= button_to domain_path(domain), method: :delete,
            class: '--bgc-transparent p-0',
            data: {turbo_confirm: "Voulez-vous supprimer ce domaine ?
Vous supprimerez tous les exercices, compétences et évaluations liés à ce domaine."} do%>
				<i class="fa-solid fa-circle-xmark ms-2"></i>
			<% end %>
		<% end %>
	</div>
<% end %>
