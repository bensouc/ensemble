<%# Calée sur le bord du contenu, comme la page des compétences qui l'accueille,
    avec de quoi y revenir. %>
<div class="domains-manage mt-3">
	<div class="domains-manage-header">
		<h2>Gérer vos domaines pour le niveau <%= grade.name %></h2>
		<%= render Ui::ButtonComponent.new("Retour aux compétences", icon: "fa-arrow-left",
		                                   href: skills_path(grade: grade), data: { turbo_frame: "_top" }) %>
	</div>
	<%= turbo_frame_tag "domains_index" do%>
		<%= turbo_frame_tag 'domains_list', data:{controller:'drag', drag_url_value:"/domains/:id/move"} do %>
			<% @domains.sort_by(&:position).each do |domain| %>
				<%= render 'domain', domain: domain %>
			<% end %>
		<% end %>
		<%# L'aide de la bascule, sous les domaines qu'elle concerne. %>
		<p class="domains-auto-hint">
			<i class="fa-solid fa-user-gear"></i>
			Barré, le domaine sort de la génération automatique de <strong>vos</strong> plans de travail :
			il reste proposé, mais décoché. Un clic sur l'icône pour basculer.
		</p>
		<%= render 'domains/add_domain', grade: grade %>
	<% end %>
</div>
