<div class="domain-form-box form-domain-btn" >
	<%= simple_form_for [domain], html: { novalidate: false } do  |f| %>
		<div class="domain-form">
			<%= f.input :name, label: false,input_html:{maxlength:29}, required: true,class: '--bgc-transparent',
      placeholder: 'Nom du domaine' %>
			<%# Un champ caché, et non `f.association :grade` : celui-ci rendait un
			    <select> de TOUS les niveaux de TOUTES les écoles dans le HTML servi
			    à chaque enseignante. Invisible à l'œil, présent dans la source, et
			    grandissant à chaque école inscrite — pour un champ dont la valeur
			    est de toute façon imposée. L'écriture, elle, était déjà gardée par
			    `DomainPolicy`, qui exige l'école du niveau. %>
			<%= f.hidden_field :grade_id, value: grade.id %>
			<% if current_user.demo? %>
				<div class="--bgc-transparent m-1"
        data-controller="tooltip"
        data-bs-toggle="tooltip"
        data-bs-placement="top"
        title="Non disponible en Démo">
					<i class="fa-solid fa-circle-check"></i>
				</div>
			<% else %>
				<%= button_tag type: 'submit', class: '--bgc-transparent' do %>
					<i class="fa-solid fa-circle-check"></i>
				<% end %>
			<% end %>
			<% if domain.persisted? %>
				<%= link_to domain_path(domain),  class: '--bgc-transparent ' do %>
					<i class="fa-solid fa-circle-xmark --grisC"></i>
				<% end %>
			<% else%>
				<%= link_to grade_domains_path(grade),  class: '--bgc-transparent ' do %>
					<i class="fa-solid fa-circle-xmark --grisC"></i>
				<% end %>
			<% end %>
		</div>
	<% end %>
</div>
