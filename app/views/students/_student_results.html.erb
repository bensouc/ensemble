<div class="student-sticky-header">
	<div class='progess-header'>
		<div
      class="d-flex align-items-baseline print-date prog-name"
      data-controller='wps-result'
    >
			<h1>Progression de
				<%= student.first_name %></h1>
			<%# La modale commune aux résultats de classe : elle coche les domaines selon
			    les préférences du professeur, et se referme à l'envoi — le plan s'ouvre
			    dans un nouvel onglet. L'ancienne modale Bootstrap, propre à cette page,
			    restait ouverte derrière. %>
			<%= link_to student_auto_gen_modal_path(student),
			            class: "--bgc-blanc",
			            data: { turbo_frame: "general_modal", controller: "tooltip",
			                    bs_toggle: "tooltip", bs_placement: "right" },
			            title: "Générer le prochain Plan de travail" do %>
				<i class="fa-solid fa-user-gear printer-logo ms-4"></i>
			<% end %>
			</div>
			<%# La légende partage la ligne de l'impression : c'est la seule bande
			    libre de l'en-tête, et une légende se consulte au passage — elle n'a
			    pas à réclamer sa propre ligne. %>
			<div class="print-date ligne-impression">
				<h4>
					<%= link_to student_path(student, format: :pdf) do %>
						<i class="fa-solid fa-print printer-logo"></i>
					<% end %>
					Le
					<%= I18n.l(Date.today, format: :long) %>
				</h4>
				<%= render "shared/legende_eval" %>
			</div>
		</div>
		<div class="top">
			<div class=" results-header domain-level nocolor">
			</div>
			<div class="d-flex">
				<% @domains.each do |domain| %>
					<div class="domain-header">
						<%= domain.name %>
					</div>
				<% end %>
			</div>
		</div>
	</div>
	<div class="results d-flex">
		<div class="left_levels">
			<% WorkPlanDomain::LEVELS.reverse_each do |level| %>
				<div class="domain-level mb-2">
					<i class=" fas fa-bacon belt-<%= level %> belt-result font-weight-bold"></i>
					<strong><%= @belt[level - 1].capitalize %></strong>
				</div>
			<% end %>
		</div>
		<div class="right-levels d-flex">
			<% @domains.each do |domain| %>
				<div class="domain-main-col">
					<%# Les cases sont rendues avec la page, depuis `@grille` : chargées une à
					    une, elles coûtaient une requête au serveur chacune. %>
					<% WorkPlanDomain::LEVELS.reverse_each do |level| %>
						<%= render "belts/belt", **@grille.case_locals(domain, level) %>
					<% end %>
				</div>
			<% end %>
		</div>
	</div>
