<%= turbo_frame_tag "general_modal"  do%>
	<div id= "myModal" data-controller='reset-frame' data-reset-frame-name-value='general_modal'>
		<%# `--width-90` faisait une boîte large de 90% de l'écran pour une liste de
		    cinq compétences : le titre se perdait à un bout, le bouton à l'autre. La
		    largeur suit maintenant le contenu, avec un plafond. %>
		<div class="modal-content modale-validation">
			<%= simple_form_for :new_wps, html: {novalidate: false} do |form|%>
				<div class="new-wps-card" >
					<div class="modal-header">
						<div>
							<h3>Compétences à valider pour <%= @student.first_name.capitalize %></h3>
							<%# Le rappel de la case cliquée : la modale ne disait pas de quel
							    domaine ni de quelle ceinture venaient ces compétences. %>
							<p class="modale-contexte">
								<%= @domain.name %> · ceinture <%= Belt::BELT_COLORS[@level - 1] %>
							</p>
						</div>
						<%# Une croix discrète dans le coin, et non un second bouton gris de la
						    taille du principal : la modale en offrait deux, celui de l'en-tête
						    posé juste après le titre, donc au milieu de la ligne. %>
						<button type="button" class="modale-fermer" aria-label="Fermer"
						        data-action="click->reset-frame#resetFrame">&times;</button>
					</div>
					<%# Quand il ne reste rien à valider, le contrôleur rend quand même cette
					    vue : la modale s'ouvrait alors sur une liste vide et un bouton
					    « Valider » qui n'avait rien à valider. On le dit, et on n'offre que
					    la sortie. %>
					<% if @no_validated_skills.blank? %>
						<p class="modale-vide">
							Toutes les compétences de ce domaine sont déjà validées pour
							<%= @student.first_name.capitalize %>.
						</p>
					<% else %>
					<div class="btn-group" role="group" aria-label="Basic checkbox toggle button group">
						<%# Un seul chemin, groupé par sous-domaine, celles qui n'en ont pas
						    en tête et sans titre.

						    Il y avait deux branches, et la groupée ne s'exécutait jamais : la
						    vue lisait `@sub_domains` quand le contrôleur posait `@subdomain`.
						    Une fois les noms accordés, elle aurait perdu les compétences sans
						    sous-domaine — elle bouclait sur les sous-domaines trouvés, et ce
						    qui n'en a pas n'appartient à aucun. Le niveau 1 du domaine 52 en
						    compte justement une, sur vingt.

						    Grouper plutôt que brancher, c'est aussi n'écrire qu'une fois les
						    attributs du champ : les deux branches avaient déjà divergé sur le
						    `data-action`. %>
						<div class="student-checkbox">
							<% competences_par_sous_domaine(@no_validated_skills).each do |sous_domaine, competences| %>
								<% if sous_domaine %>
									<h6><%= sous_domaine.capitalize %></h6>
								<% end %>
								<div class="groupe-competences">
									<%= form.input_field :skills,
									                     collection: competences,
									                     label_method: ->(skill) { skill.name },
									                     value_method: ->(skill) { skill.id },
									                     multiple: true,
									                     as: :check_boxes,
									                     boolean_style: :inline,
									                     class: "tag-selector",
									                     item_wrapper_class: "tag-item" %>
								</div>
							<% end %>
						</div>
					</div>
					<% end %>
				</div>
				<%# « Annuler » plutôt qu'un X : à côté de « Valider », une croix seule ne
				    dit pas ce qu'elle annule, et se lisait comme un bouton inachevé. %>
				<div class="modale-actions">
					<% if @no_validated_skills.blank? %>
						<button type="button" class="utility-wp-btn utility-wp-btn--primary"
						        data-action="click->reset-frame#resetFrame">Fermer</button>
					<% else %>
						<button type="button" class="utility-wp-btn--neutre"
						        data-action="click->reset-frame#resetFrame">Annuler</button>
						<%= form.button :button, "Valider", class: "utility-wp-btn utility-wp-btn--primary" %>
					<% end %>
				</div>
			<% end %>
		</div>
	</div>
<% end %>
