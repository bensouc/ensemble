<h1 style="<%= mail_style(:titre) %>">Les résultats de votre classe sont prêts</h1>

<p style="<%= mail_style(:texte) %>">
	Bonjour <strong><%= @teacher.first_name&.strip.presence&.capitalize %></strong>,
	les résultats de <strong><%= @classroom.safe_name %></strong>, à la date du
	<%= I18n.l(Time.current, format: :full_day_month_year) %>, sont disponibles.
</p>

<div style="text-align:center; padding:14px 0 10px 0;">
	<%= mail_button("Télécharger les résultats (ZIP)", @download_url) %>
</div>
<div style="text-align:center; padding-bottom:22px;"><%= mail_button_fallback(@download_url) %></div>

<%= mail_divider %>

<p style="<%= mail_style(:note) %> margin-top:20px; margin-bottom:0;">
	Ce lien est valable 7 jours. Passé ce délai, régénérez les résultats depuis l'application.
</p>
