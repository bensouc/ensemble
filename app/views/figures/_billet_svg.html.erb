<%# Billet simplifié (couleurs : `Figure#billet_dessin`) : le chiffre, « EURO » et une arche, comme sur le vrai, sans pouvoir être pris pour lui. %>
<% d = dessinable.billet_dessin %>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 130 68" width="<%= d[:largeur] %>em" height="<%= d[:hauteur] %>em" role="img" aria-label="<%= dessinable.libelle %>"><rect x="1" y="1" width="128" height="66" rx="5" fill="<%= d[:fond] %>" stroke="<%= d[:trait] %>" stroke-width="1.5"></rect><rect x="1.75" y="1.75" width="30" height="64.5" rx="4" fill="<%= d[:trait] %>" fill-opacity="0.16"></rect><path d="M40 60V38a10 10 0 0 1 20 0v22M36 60h28" fill="none" stroke="<%= d[:trait] %>" stroke-width="2.5" stroke-opacity="0.3" stroke-linecap="round"></path><text x="7" y="23" font-family="Poppins, Arial, sans-serif" font-size="18" font-weight="800" fill="<%= d[:trait] %>"><%= dessinable.valeur %></text><text x="8" y="60" font-family="Poppins, Arial, sans-serif" font-size="8.5" font-weight="700" fill="<%= d[:trait] %>">EURO</text><text x="123" y="59" text-anchor="end" font-family="Poppins, Arial, sans-serif" font-size="40" font-weight="800" fill="<%= d[:trait] %>"><%= dessinable.valeur %></text></svg>
