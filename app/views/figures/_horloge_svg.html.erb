<%#
  Cadran d'horloge, dessiné dans un carré de 200 (géométrie : `Figure`).

  `dy` et non `dominant-baseline` pour centrer les chiffres : le sanitizer
  d'ActionText retire ce dernier attribut. `xmlns` : le même dessin sert d'image
  (data URI) dans l'éditeur, où Trix retire les attributs d'un SVG en ligne.
%>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200" role="img" aria-label="<%= dessinable.libelle %>"><circle cx="100" cy="100" r="94" fill="#fff" stroke="#3D3D3D" stroke-width="4"></circle><% dessinable.graduations.each do |g| %><line x1="<%= g[:x1] %>" y1="<%= g[:y1] %>" x2="<%= g[:x2] %>" y2="<%= g[:y2] %>" stroke="#3D3D3D" stroke-width="<%= g[:epaisseur] %>" stroke-linecap="round"></line><% end %><% if dessinable.chiffres? %><% dessinable.chiffres_du_cadran.each do |c| %><text x="<%= c[:x] %>" y="<%= c[:y] %>" dy="0.35em" text-anchor="middle" font-family="Poppins, Arial, sans-serif" font-size="19" font-weight="600" fill="#3D3D3D"><%= c[:texte] %></text><% end %><% end %><% unless dessinable.horloge_vide? %><% x, y = dessinable.petite_aiguille %><line x1="100" y1="100" x2="<%= x %>" y2="<%= y %>" stroke="#3D3D3D" stroke-width="8" stroke-linecap="round"></line><% x, y = dessinable.grande_aiguille %><line x1="100" y1="100" x2="<%= x %>" y2="<%= y %>" stroke="#3D3D3D" stroke-width="4.5" stroke-linecap="round"></line><% end %><circle cx="100" cy="100" r="6" fill="#3D3D3D"></circle></svg>
