<%#
  Rendu d'une figure à l'affichage et dans les PDF.

  `figure` est la pièce jointe ActionText (elle délègue à la Figure) : c'est
  elle qui porte l'attribut `presentation`, donc la taille et la position.

  Pas de helper d'application ici : rails_admin rend aussi ce partial, sans eux.
%>
<% classes = ["rt-figure", "rt-figure--#{figure.kind}", ("rt-figure--marge" if figure.kind == :seyes && figure.marge?)].compact %>
<% if figure.inline? %>
  <span class="<%= classes.join(" ") %>"><%= render "figures/picto_svg", dessinable: figure %></span>
<% else %>
  <% presentation = FigurePresentation.attributs(figure, defaut: figure.presentation_par_defaut) %>
  <figure class="<%= (classes + presentation[:classes]).join(" ") %>"<% if presentation[:style] %> style="<%= presentation[:style] %>"<% end %>>
    <%# Un dessin par sorte : figures/_seyes_svg, _horloge_svg, _zone_svg… %>
    <%= render "figures/#{figure.kind}_svg", dessinable: figure %>
  </figure>
<% end %>
