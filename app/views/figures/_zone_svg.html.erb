<%#
  Zone de manipulation (`Figure#zone_dessin`) : un seul SVG, où chaque matériel
  est posé à sa place. Le sanitizer d'ActionText retire `position`, `left` et
  `top` d'un style : seul un dessin peut placer librement des éléments. Une
  unité du dessin vaut un pas de la grille, un quart d'em.
%>
<% z = dessinable.zone_dessin %>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 <%= z[:largeur] %> <%= z[:hauteur] %>" width="<%= z[:largeur_em] %>em" height="<%= z[:hauteur_em] %>em" role="img" aria-label="<%= dessinable.libelle %>"><% z[:elements].each do |e| %><svg x="<%= e[:x] %>" y="<%= e[:y] %>" width="<%= e[:largeur] %>" height="<%= e[:hauteur] %>" viewBox="<%= e[:materiel].materiel_boite %>"><%= render "figures/#{e[:materiel].kind}_formes", dessinable: e[:materiel] %></svg><% end %></svg>
