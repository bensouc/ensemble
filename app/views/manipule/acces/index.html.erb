<div class="container py-4 m-prof">
  <%= render "manipule/shared/nav" %>
  <%= render "manipule/shared/entete", titre: "Les accès",
             note: "Manipule est une option, ouverte compte par compte le temps de l'essai. " \
                   "#{@ouverts > 1 ? "#{@ouverts} comptes l'ont" : "#{@ouverts} compte l'a"} aujourd'hui." %>

  <%= form_with url: manipule_acces_path, method: :get, class: "d-flex flex-wrap align-items-center gap-2 mb-4" do %>
    <%= text_field_tag :q, @recherche, class: "area", style: "width: 20rem;",
                       placeholder: "Chercher par nom ou adresse", "aria-label": "Chercher un compte" %>
    <button type="submit" class="m-cta"><i class="fa-solid fa-magnifying-glass"></i><span>Chercher</span></button>
    <% if @recherche.present? %>
      <%= link_to "Revenir aux comptes ouverts", manipule_acces_path %>
    <% end %>
  <% end %>

  <% if @utilisateurs.empty? %>
    <p class="m-fiche-note">
      <% if @recherche.present? %>
        Aucun compte ne correspond à « <%= @recherche %> ».
      <% else %>
        Aucun compte n'a l'option. Cherchez un nom pour l'ouvrir à quelqu'un.
      <% end %>
    </p>
  <% else %>
    <% @utilisateurs.each do |utilisateur| %>
      <div class="m-fiche d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <div>
          <h2 class="m-fiche-titre">
            <%= utilisateur.email %>
            <% if utilisateur.admin? %><span class="m-etiquette">admin</span><% end %>
          </h2>
          <p class="m-fiche-note">
            <%= "#{utilisateur.first_name} #{utilisateur.last_name}".strip.presence %>
            <%= "· #{utilisateur.school.name}" if utilisateur.school %>
          </p>
        </div>
        <div class="d-flex align-items-center gap-3 flex-shrink-0">
          <% if utilisateur.manipule? %>
            <span class="m-etiquette m-etiquette--juste">ouverte</span>
          <% elsif utilisateur.admin? %>
            <span class="m-fiche-note">par son statut d'admin</span>
          <% else %>
            <span class="m-etiquette">fermée</span>
          <% end %>
          <%= button_to manipule_acces_utilisateur_path(utilisateur), method: :patch,
                        params: { manipule: !utilisateur.manipule?, q: @recherche },
                        class: "m-cta #{'m-cta--discret' if utilisateur.manipule?}" do %>
            <i class="fa-solid fa-<%= utilisateur.manipule? ? "lock" : "lock-open" %>"></i>
            <span><%= utilisateur.manipule? ? "Fermer" : "Ouvrir" %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
