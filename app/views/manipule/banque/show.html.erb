<div class="container py-4 m-prof">
  <%= render "manipule/shared/nav" %>

  <p class="mb-1"><%= link_to "← Les problèmes", manipule_banque_path %></p>
  <h1 class="mb-1"><%= @competence.name %></h1>
  <p class="m-fiche-note">
    Ceinture <%= Belt::BELT_COLORS[@competence.level - 1] %> ·
    <%= @problemes.count(&:published) %> visibles,
    <%= au_pluriel(@problemes.count { |probleme| !probleme.published }, "brouillon") %>
  </p>

  <div class="d-flex flex-wrap gap-2 my-4">
    <%# Vert pour ce qui crée, pastille teintée pour le reste : c'est la
        distinction qu'Ensemble fait partout ailleurs. %>
    <%= link_to manipule_nouveau_probleme_path(@competence), class: "m-cta m-cta--creer" do %>
      <i class="fa-solid fa-plus"></i><span>Nouveau problème</span>
    <% end %>
    <%= link_to manipule_banque_import_path(@competence), class: "m-cta" do %>
      <i class="fa-solid fa-file-arrow-up"></i><span>Importer un tableur</span>
    <% end %>
    <% if @problemes.any? { |probleme| !probleme.published } %>
      <%= button_to manipule_banque_publier_path(@competence), class: "m-cta" do %>
        <i class="fa-solid fa-eye"></i><span>Tout rendre visible</span>
      <% end %>
    <% end %>
  </div>

  <% if @problemes.empty? %>
    <p class="m-fiche-note">Aucun problème sur cette compétence.</p>
  <% else %>
    <% @problemes.each do |probleme| %>
      <%# Les actions en pied de carte, pas en colonne de droite : en colonne,
          elles basculaient sous le texte dès qu'un énoncé était un peu long,
          et chaque carte se présentait différemment. %>
      <div class="m-fiche">
        <p class="mb-1"><%= probleme.statement %></p>
        <p class="m-fiche-note mb-2"><%= probleme.question %></p>

        <%# Ce que l'élève verra : la relecture avant de les rendre visibles. %>
        <div class="d-flex flex-wrap gap-2">
          <% if probleme.choix? %>
            <% probleme.choices.each do |choix| %>
              <span class="m-etiquette <%= "m-etiquette--juste" if choix.correct? %>"><%= choix.label %></span>
            <% end %>
          <% else %>
            <span class="m-etiquette m-etiquette--juste">
              à écrire : <%= probleme.answer %> <%= probleme.unit %>
            </span>
          <% end %>
        </div>

        <%# L'outil sur sa propre ligne, dans sa propre teinte : au milieu des
            réponses, il se lisait comme une quatrième. %>
        <div class="mt-2">
          <% if probleme.jetons? %>
            <span class="m-etiquette m-etiquette--outil">
              <i class="fa-solid fa-hand-pointer me-2"></i>
              Jetons — <%= au_pluriel(probleme.jeton_reserve, "jeton") %>
              <%= probleme.jeton_caractere %>,
              <%= probleme.jeton_zones.to_sentence(two_words_connector: " et ", last_word_connector: " et ") %>
            </span>
          <% else %>
            <span class="m-fiche-note">Sans outil de manipulation.</span>
          <% end %>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-2 border-top">
          <span class="m-etiquette <%= "m-etiquette--active" if probleme.published %>">
            <%= probleme.published ? "visible" : "brouillon" %>
          </span>
          <div class="d-flex flex-wrap gap-1">
            <%= link_to manipule_edition_probleme_path(probleme), class: "m-cta m-cta--discret" do %>
              <i class="fa-solid fa-pen"></i><span>Modifier</span>
            <% end %>
            <%# Écrire dix problèmes qui ne diffèrent que par leurs nombres est
                le quotidien de l'enseignante. %>
            <%= button_to manipule_dupliquer_probleme_path(probleme), class: "m-cta m-cta--discret",
                          title: "Dupliquer ce problème" do %>
              <i class="fa-regular fa-clone"></i><span>Dupliquer</span>
            <% end %>
            <%= button_to manipule_probleme_circulation_path(probleme), method: :patch,
                          class: "m-cta m-cta--discret" do %>
              <i class="fa-solid fa-eye<%= "-slash" if probleme.published %>"></i>
              <span><%= probleme.published ? "Masquer" : "Rendre visible" %></span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
