<% juste = @tentative.status == "correct" %>
<div class="m-verdict <%= juste ? "m-juste" : "m-faux" %>">
  <span class="m-marque"><%= juste ? "✓" : "✗" %></span>
  <p class="m-verdict-texte">
    <% if juste %>
      Bravo !
    <% elsif @tentative.status == "skipped" %>
      Tu as passé cette manipulation.
    <% else %>
      Ce n'est pas ça.
    <% end %>
  </p>
</div>

<%= link_to "Manipulation suivante →", manipule_serie_path, class: "m-suivant" %>

<%= render "manipule/practices/sortie" %>
