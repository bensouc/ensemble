<%# La barre des écrans de l'enseignante. Elle ne figure QUE sur ses pages :
    le gabarit de l'élève, lui, n'offre volontairement aucune sortie.

    Un soulignement marque l'onglet courant, comme le menu de gauche marque
    l'entrée courante par la couleur. Ensemble ne connaît pas les pastilles
    de Bootstrap. %>
<div class="d-flex align-items-baseline flex-wrap gap-4 mb-4">
  <%= link_to manipule_root_path, class: "h4 mb-0 text-decoration-none d-inline-flex align-items-baseline gap-2" do %>
    Manipule<span class="m-beta">bêta</span>
  <% end %>
  <ul class="m-onglets">
    <% onglets_manipule.each do |onglet| %>
      <li>
        <%= link_to onglet[:libelle], onglet[:chemin],
                    class: ("actif" if onglet_manipule_actif?(onglet)),
                    aria: { current: ("page" if onglet_manipule_actif?(onglet)) } %>
      </li>
    <% end %>
  </ul>
</div>
<div class="grey-line-full"></div>
