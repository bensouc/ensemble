<div class="px-4 py-4 m-prof">
  <%= render "manipule/shared/nav" %>
  <%= render "manipule/shared/entete", titre:,
             retour: { libelle: competence.name, chemin: manipule_banque_competence_path(competence) },
             note: "Le formulaire à gauche, ce que l'élève verra à droite." %>

  <%# Un contrôleur Stimulus, et non plus une balise <script> sur cette seule
      page : un module ES ne s'exécute qu'une fois par adresse, et Turbo ne le
      rejoue ni à la visite suivante ni au rendu 422 d'une validation refusée.
      `connect()` ne connaît pas ces cas particuliers. %>
  <div class="m-editeur" data-controller="manipule-editeur"
       data-action="input->manipule-editeur#saisie change->manipule-editeur#changement">
    <div>
      <%= render "manipule/problemes/formulaire",
                 probleme:, competence:, url:, methode:, bouton: %>
    </div>

    <%# L'aperçu n'est pas une maquette : c'est la page de l'élève, rendue par
        les mêmes gabarits, avec sa feuille de style et son JavaScript. D'où le
        cadre — sans lui il faudrait charger la CSS de l'élève par-dessus celle
        d'Ensemble, et les deux se marcheraient dessus. Les jetons s'y déplacent
        pour de vrai. %>
    <div class="m-apercu">
      <p class="m-apercu-titre">
        Ce que l'élève verra
        <%# La colonne de droite fait quatre cents pixels, l'écran d'un élève
            en fait neuf cents : un outil de manipulation n'y tient pas, et le
            rétrécir jusqu'à ce qu'il y tienne serait le dessiner pour le
            mauvais écran. D'où ce bouton — l'aperçu prend toute la largeur, et
            on voit ce que l'élève voit, à sa taille. %>
        <button type="button" class="m-agrandir"
                data-manipule-editeur-target="agrandir"
                data-action="manipule-editeur#agrandir"
                aria-label="Agrandir l'aperçu">Agrandir</button>
      </p>
      <iframe class="m-apercu-cadre" data-manipule-editeur-target="apercu"
              title="Aperçu de l'écran de l'élève"></iframe>
      <span class="m-champ-aide">Il se met à jour pendant que vous écrivez. Rien n'y est enregistré.</span>
    </div>
  </div>
</div>
