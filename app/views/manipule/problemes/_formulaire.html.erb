<%# `as: :probleme` : sans lui, simple_form nomme ses champs d'après le modèle
    — `manipule_problem[…]` — alors que le reste du formulaire et le contrôleur
    parlent français. Les deux moitiés ne se rejoindraient pas, et l'aperçu
    répondrait 422 sans que rien ne le dise à l'écran. Une spec vérifie ces
    noms, justement parce que ça s'est produit. %>
<%# `wrapper: :manipule` : les gabarits d'Ensemble posent une classe « valide »
    sur chaque champ dès l'ouverture d'un formulaire vierge, et huit champs
    bordés de vert ne disent rien à personne. Les nôtres en sont dépourvus. %>
<%= simple_form_for probleme, as: :probleme, url: url,
                    wrapper: :manipule,
                    wrapper_mappings: { radio_buttons: :manipule_collection },
                    html: { method: methode, novalidate: false,
                            data: { "m-editeur": true,
                                    "manipule-editeur-target": "formulaire",
                                    apercu: manipule_apercu_probleme_path(competence) } } do |f| %>
  <div class="form-inputs">
    <%= f.input :statement, label: "L'énoncé", as: :text,
                input_html: { rows: 3, class: "area",
                              placeholder: "Ex. Il y a 15 pommes sur le pommier. Sam cueille 7 pommes." },
                hint: "L'histoire, sans la question. C'est ce que l'élève entend en premier." %>

    <%= f.input :question, label: "La question",
                input_html: { class: "area",
                              placeholder: "Ex. Combien reste-t-il de pommes sur le pommier ?" } %>

    <%= f.input :answer_mode, label: "Comment l'élève répond", as: :radio_buttons,
                collection: [["Trois réponses au choix", "choix"], ["Un nombre à écrire", "saisie"]],
                label_method: :first, value_method: :last %>

    <%# Les trois réponses, avec un bouton radio pour la bonne : le modèle en
        exige exactement une, et trois cases à cocher permettraient d'en cocher
        zéro ou trois. La contrainte est portée par le formulaire lui-même. %>
    <div class="m-champ" data-m-si-choix>
      <label class="form-label">Les trois réponses</label>
      <%# La consigne AVANT les champs : placée dessous, elle se lisait en
          dernier, et trois ronds muets à gauche de trois cases ne disent pas
          d'eux-mêmes qu'il faut désigner la bonne. %>
      <span class="m-champ-aide d-block mb-2">
        Écrivez les trois, puis <strong>cochez celle qui est juste</strong> — les deux autres
        sont les pièges.
      </span>
      <p class="m-colonne-juste">Laquelle est juste ?</p>
      <% f.object.choices.each_with_index do |choix, rang| %>
        <%= f.fields_for :choices, choix, child_index: rang do |c| %>
          <div class="m-case m-case-reponse">
            <%# Le rond porte son mot : « juste ». Sans lui, rien à l'écran ne
                dit ce qu'on désigne en le cochant. %>
            <label class="m-juste">
              <%= radio_button_tag "probleme[bonne_reponse]", rang, choix.correct?,
                                   "aria-label": "La réponse #{rang + 1} est la bonne" %>
              <span>juste</span>
            </label>
            <%= c.hidden_field :id %>
            <%= c.hidden_field :position, value: rang + 1 %>
            <%= c.text_field :label, class: "area",
                                     placeholder: ["Ex. 8", "Ex. 7", "Ex. 22"][rang] || "Ex. 12",
                                     "aria-label": "Réponse #{rang + 1}" %>
          </div>
        <% end %>
      <% end %>

      <%# Il n'y avait plus qu'un encart en haut de page, et il répétait mot
          pour mot ce que chaque champ dit déjà sous lui. Restent ces deux-là,
          qui n'ont nulle part où s'afficher : les cases sont écrites à la
          main, donc sans l'habillage de simple_form, et « exactement une
          bonne réponse » porte sur les trois ensemble. Elles se lisent ici,
          sous le bloc qu'elles concernent.
          `uniq` : trois cases vides donnaient trois fois la même phrase. %>
      <% probleme.errors.
           select { |erreur| erreur.attribute == :base || erreur.attribute.to_s.start_with?("choices.") }.
           map(&:full_message).uniq.each do |message| %>
        <div class="invalid-feedback d-block"><%= message %></div>
      <% end %>
    </div>

    <div class="row g-2 m-champ" data-m-si-saisie>
      <div class="col"><%= f.input :answer, label: "La réponse attendue",
                                   input_html: { class: "area", placeholder: "Ex. 8" } %></div>
      <div class="col"><%= f.input :unit, label: "L'unité",
                                   input_html: { class: "area", placeholder: "Ex. pommes" } %></div>
    </div>

    <%= f.input :tool, label: "Un outil à manipuler",
                collection: [["Des jetons à déplacer", "jetons"],
                             ["Des dizaines et des unités", "dizaines_unites"],
                             ["Une horloge à régler", "horloge"],
                             ["Un partage en boîtes", "partage"]],
                include_blank: "Aucun",
                input_html: { class: "area", data: { "m-outil": true } },
                hint: "L'outil aide l'élève à se représenter l'énoncé. Il ne corrige rien : " \
                      "la réponse reste celle du dessus." %>

    <div class="m-champ ps-3 border-start" data-m-si="jetons">
      <div class="row g-2 mb-2">
        <div class="col">
          <%= label_tag "probleme[reglages][jetons][ressource]", "Le jeton", class: "form-label" %>
          <%= select_tag "probleme[reglages][jetons][ressource]",
                         options_for_select(Manipule::Problem::RESSOURCES.map { |nom, signe| ["#{signe} #{nom}", nom] },
                                            probleme.tool_data["ressource"]),
                         class: "area" %>
        </div>
        <div class="col">
          <%= label_tag "probleme[reglages][jetons][reserve]", "Combien en réserve", class: "form-label" %>
          <%= number_field_tag "probleme[reglages][jetons][reserve]", probleme.tool_data["reserve"] || 10,
                               min: 0, max: Manipule::Problem::RESERVE_MAX, class: "area" %>
        </div>
      </div>

      <%# Deux cases au départ, une de plus si la manipulation en a déjà, et le
          bouton pour en ajouter. Les vides sont ignorées à l'enregistrement. %>
      <label class="form-label">Les cases où il pose les jetons</label>
      <div data-m-cases>
        <% cases = probleme.jeton_zones %>
        <% [cases.size + 1, 2].max.times do |rang| %>
          <div class="m-case" data-m-case>
            <%= text_field_tag "probleme[reglages][jetons][zones][]", cases[rang], class: "area",
                               placeholder: ["Ex. Le panier de Sam", "Ex. Restées sur l'arbre"][rang] || "Ex. Le sac de Lila",
                               "aria-label": "Nom de la case #{rang + 1}" %>
            <button type="button" class="rmv-skill-btn" data-m-retirer-case
                    aria-label="Retirer cette case"><i class="far fa-times-circle"></i></button>
          </div>
        <% end %>
      </div>
      <button type="button" class="m-cta m-cta--creer" data-m-ajouter-case
              data-max="<%= Manipule::Problem::ZONES_MAX %>">
        <i class="fa-solid fa-plus"></i><span>Ajouter une case</span>
      </button>
      <span class="m-champ-aide">Nommez-les d'après l'énoncé : l'élève doit lire où il pose.</span>
    </div>

    <div class="m-champ ps-3 border-start" data-m-si="dizaines_unites">
      <%= label_tag "probleme[reglages][dizaines_unites][depart]", "Déjà posé sur la zone", class: "form-label" %>
      <%= number_field_tag "probleme[reglages][dizaines_unites][depart]", probleme.tool_data["depart"] || 0,
                           min: 0, max: (Manipule::Problem::DIZAINES_MAX * 10) + 9, class: "area" %>
      <span class="m-champ-aide">
        Laissez 0 pour qu'il parte de rien. Il pioche ensuite autant de dizaines et d'unités
        qu'il veut : construire une dizaine avec dix unités est un geste, en prendre une toute
        faite en est un autre.
      </span>

    </div>

    <div class="m-champ ps-3 border-start" data-m-si="horloge">
      <div class="row g-2 mb-2">
        <div class="col">
          <%= label_tag "probleme[reglages][horloge][heure]", "L'heure de départ", class: "form-label" %>
          <%# Un champ d'heure du navigateur : au clavier comme au doigt, il
              sait déjà ce qu'est une heure, et il parle la langue du poste. %>
          <%= time_field_tag "probleme[reglages][horloge][heure]",
                             format("%<h>02d:%<m>02d", h: probleme.horloge_minutes / 60,
                                                       m: probleme.horloge_minutes % 60),
                             class: "area" %>
        </div>
        <div class="col">
          <%= label_tag "probleme[reglages][horloge][pas]", "L'aiguille avance de", class: "form-label" %>
          <%= select_tag "probleme[reglages][horloge][pas]",
                         options_for_select(Manipule::Problem::PAS_HORLOGE.map { |pas| ["#{pas} min", pas] },
                                            probleme.horloge_pas),
                         class: "area" %>
        </div>
      </div>
      <span class="m-champ-aide">
        L'élève fait tourner les aiguilles lui-même. Au CP, un pas de 5 minutes
        suffit : viser la minute exacte à la souris n'apprend rien.
      </span>
    </div>

    <div class="m-champ ps-3 border-start" data-m-si="partage">
      <div class="row g-2 mb-2">
        <div class="col">
          <%= label_tag "probleme[reglages][partage][ressource]", "À partager", class: "form-label" %>
          <%= select_tag "probleme[reglages][partage][ressource]",
                         options_for_select(Manipule::Problem::RESSOURCES.map { |nom, signe| ["#{signe} #{nom}", nom] },
                                            probleme.tool_data["ressource"]),
                         class: "area" %>
        </div>
        <div class="col">
          <%= label_tag "probleme[reglages][partage][objets]", "Combien à partager", class: "form-label" %>
          <%= number_field_tag "probleme[reglages][partage][objets]", probleme.partage_objets.nonzero? || 12,
                               min: 0, max: Manipule::Problem::RESERVE_MAX, class: "area" %>
        </div>
        <div class="col">
          <%= label_tag "probleme[reglages][partage][boites]", "Boîtes au départ", class: "form-label" %>
          <%= number_field_tag "probleme[reglages][partage][boites]", probleme.partage_boites,
                               min: 0, max: Manipule::Problem::BOITES_MAX, class: "area" %>
        </div>
      </div>
      <span class="m-champ-aide">
        C'est l'ÉLÈVE qui ajoute et retire les boîtes : combien de parts faire est
        souvent LA question. Laissez 0 pour qu'il parte d'un plateau nu.
      </span>
    </div>
  </div>

    <%# Le compte peut DONNER la réponse — « en tout 12 », ou « à placer 10 »
        sur un problème qui demande combien il reste. Le réglage vaut donc pour
        tous les outils, et il est posé une seule fois. %>
    <div class="m-champ ps-3 border-start" data-m-si-outil>
      <div class="form-check">
        <%= hidden_field_tag "probleme[reglages][compteur]", "0" %>
        <%= check_box_tag "probleme[reglages][compteur]", "1", probleme.compteur?,
                          class: "form-check-input", id: "compteur_de_l_outil" %>
        <%= label_tag "compteur_de_l_outil", "Montrer le compte à l'élève", class: "form-check-label" %>
      </div>
      <span class="m-champ-aide">
        Le total des jetons, le nombre du plateau, l'heure de l'horloge, ce qu'il y a
        dans chaque boîte. Décoché, l'élève manipule sans voir aucun nombre — c'est
        souvent ce qu'on veut, puisque le compte donne parfois la réponse.
      </span>
    </div>

  <div class="form-actions d-flex align-items-center gap-3 mt-3">
    <button type="submit" class="m-cta m-cta--principal">
      <i class="fa-solid fa-check"></i><span><%= bouton %></span>
    </button>
    <%= link_to "Annuler", manipule_banque_competence_path(competence) %>
  </div>
<% end %>
