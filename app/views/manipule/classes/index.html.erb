<div class="px-4 py-4 m-prof">
  <%= render "manipule/shared/nav" %>
  <%= render "manipule/shared/entete", titre: "Mes classes",
             note: "Choisissez une classe pour désigner ce que chaque élève travaille, " \
                   "et voir ce que ça a donné." %>

  <% if @classes.empty? %>
    <p class="m-fiche-note">Aucune classe.</p>
  <% else %>
    <div class="row g-3">
      <% @classes.each do |classe| %>
        <div class="col-md-6 col-xxl-4">
          <div class="m-fiche h-100 d-flex justify-content-between align-items-center gap-3">
            <div>
              <h2 class="m-fiche-titre"><%= classe.name %></h2>
              <p class="m-fiche-note"><%= au_pluriel(classe.students.size, "élève") %></p>
            </div>
            <%= link_to manipule_suivi_classe_path(classe), class: "m-cta flex-shrink-0" do %>
              <span>Ouvrir</span><i class="fa-solid fa-chevron-right"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
