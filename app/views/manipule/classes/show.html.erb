<div class="px-4 py-4 m-prof">
  <%= render "manipule/shared/nav" %>
  <%= render "manipule/shared/entete", titre: @classe.name,
             retour: { libelle: "Mes classes", chemin: manipule_suivi_path },
             note: au_pluriel(@eleves.size, "élève") %>

  <div class="m-fiche mb-4">
    <h2 class="m-fiche-titre">L'adresse des élèves</h2>
    <p class="mb-2"><code><%= manipule_classe_url(token: @jeton.token) %></code></p>
    <p class="m-fiche-note mb-3">
      À projeter ou à coller sur les postes. Qui possède cette adresse peut se faire passer pour
      n'importe quel élève de la classe — renouvelez-la si elle a circulé plus loin.
    </p>
    <%= button_to manipule_suivi_jeton_path(@classe), class: "m-cta m-cta--discret" do %>
      <i class="fa-solid fa-rotate"></i><span>Renouveler l'adresse</span>
    <% end %>
  </div>

  <% if @competences.empty? %>
    <div class="m-fiche m-fiche-erreur mb-4">
      Aucune compétence de ce niveau n'a de problème visible.
      <%= link_to "Écrivez des problèmes", manipule_banque_path %> avant de désigner quoi que ce soit.
    </div>
  <% else %>
    <div class="m-fiche mb-4">
      <h2 class="m-fiche-titre">Désigner pour toute la classe</h2>
      <%= form_with url: manipule_suivi_affecter_path(@classe), method: :post,
                    class: "d-flex gap-2 flex-wrap align-items-center mt-2" do |f| %>
        <%= label_tag :skill_id, "Compétence", class: "visually-hidden" %>
        <%= select_tag :skill_id,
                       options_for_select(@competences.map { |c| ["#{c.name} — ceinture #{Belt::BELT_COLORS[c.level - 1]}", c.id] }),
                       class: "area", style: "width: auto;" %>
        <button type="submit" class="m-cta m-cta--principal">
          <i class="fa-solid fa-check"></i><span>Désigner pour tous</span>
        </button>
      <% end %>
    </div>
  <% end %>

  <h2 class="h5 mb-3">Les élèves</h2>
  <% @eleves.each do |eleve| %>
    <% affectation = @affectations[eleve.id] %>
    <% serie = @dernieres[eleve.id] %>
    <div class="m-fiche">
      <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div class="flex-grow-1">
          <h3 class="m-fiche-titre">
            <%# Les totaux disent qu'il a raté quatre problèmes ; ils ne disent
                pas lesquels. Le prénom mène au détail. %>
            <%= link_to eleve.first_name, manipule_suivi_eleve_path(eleve), class: "text-decoration-none" %>
          </h3>
          <p class="m-fiche-note mb-1">
            <% if affectation %>
              Travaille « <%= affectation.skill.name %> »
            <% else %>
              Rien de désigné — cet élève tomberait sur « Rien à faire pour le moment ».
            <% end %>
          </p>
          <p class="m-fiche-note mb-0">
            <% if serie.nil? %>
              Jamais venu.
            <% else %>
              <%# « Passé » n'est pas « faux » : les deux chiffres restent séparés. %>
              <%= l(serie.created_at, format: :short) %> ·
              <%= serie.attempts.count { |t| t.status == "correct" } %> juste,
              <%= serie.attempts.count { |t| t.status == "wrong" } %> faux,
              <%= serie.attempts.count { |t| t.status == "skipped" } %> passé
              <% ecoutes = serie.attempts.sum(&:listened_count) %>
              <%= "· #{au_pluriel(ecoutes, 'écoute')}" if ecoutes.positive? %>
            <% end %>
          </p>
        </div>

        <% if @competences.any? %>
          <%= form_with url: manipule_suivi_affecter_path(@classe), method: :post,
                        class: "d-flex gap-2 flex-shrink-0 align-items-center" do |f| %>
            <%= hidden_field_tag :student_id, eleve.id %>
            <%= select_tag :skill_id,
                           options_for_select(@competences.map { |c| [c.name, c.id] }, affectation&.skill_id),
                           class: "area", style: "width: auto; max-width: 16rem;",
                           "aria-label": "Compétence de #{eleve.first_name}" %>
            <button type="submit" class="m-cta"><i class="fa-solid fa-check"></i><span>Désigner</span></button>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @qui_coince.any? %>
    <h2 class="h5 mt-4 mb-1">Là où ça coince</h2>
    <p class="m-fiche-note mb-3">Les problèmes ratés ou passés le plus souvent, tous élèves confondus.</p>
    <% @qui_coince.each do |probleme, nombre| %>
      <div class="m-fiche d-flex justify-content-between gap-3">
        <span><%= probleme.statement %></span>
        <span class="m-etiquette flex-shrink-0"><%= nombre %></span>
      </div>
    <% end %>
  <% end %>
</div>
