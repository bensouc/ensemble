<% lien = edit_password_url(@resource, reset_password_token: @token) %>

<h1 style="<%= mail_style(:titre) %>">Changer votre mot de passe</h1>

<p style="<%= mail_style(:texte) %>">
	Bonjour <strong><%= @resource.first_name&.strip.presence&.capitalize || @resource.email %></strong>,
	quelqu'un a demandé un lien pour changer le mot de passe de votre compte Ensemble.
</p>

<div style="text-align:center; padding:14px 0 10px 0;"><%= mail_button("Changer mon mot de passe", lien) %></div>
<div style="text-align:center; padding-bottom:22px;"><%= mail_button_fallback(lien) %></div>

<%= mail_divider %>

<p style="<%= mail_style(:note) %> margin-top:20px; margin-bottom:0;">
	Si vous n'êtes pas à l'origine de cette demande, ignorez ce message : votre mot de passe
	ne changera pas tant que vous n'aurez pas suivi le lien ci-dessus pour en choisir un nouveau.
</p>
