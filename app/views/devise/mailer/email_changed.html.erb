<%# Envoyé seulement si `config.send_email_changed_notification` est activé. %>
<h1 style="<%= mail_style(:titre) %>">Votre adresse email a changé</h1>

<p style="<%= mail_style(:texte) %>">
	Bonjour <strong><%= @email || @resource.email %></strong>,
	<% if @resource.try(:unconfirmed_email?) %>
		l'adresse de votre compte Ensemble est en cours de changement vers
		<strong><%= @resource.unconfirmed_email %></strong>.
	<% else %>
		l'adresse de votre compte Ensemble est désormais
		<strong><%= @resource.email %></strong>.
	<% end %>
</p>

<p style="<%= mail_style(:note) %> margin-bottom:0;">
	Si vous n'en êtes pas à l'origine, contactez-nous depuis le formulaire du site.
</p>
