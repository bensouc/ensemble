<div class="container3">
	<h1 class="mb-4">
		Groupe <%= @school.name %>
	</h1>
	<div class="school-show">
		<div class="teachers-list subscription-details --border-10px">
			<h4><i class="fa-solid fa-database"></i>
				Statistiques</h4>
			<br>
			<div class="group-number-card">
				<p><i class="fa-solid fa-users"></i>
					<%= "#{@teachers.count} Membre#{"s" if @teachers.count > 1}" %></p>
				<%# Invitation par mail : le collègue choisit son propre mot de passe. Avant,
				    ce lien menait au formulaire d'inscription, où le responsable saisissait
				    le mot de passe à sa place et le lui envoyait en clair. %>
				<% if policy(@school).invite_teacher? %>
					<%= link_to new_user_invitation_path do %>
						<i
              class="fa-solid fa-user-plus"
              data-controller="tooltip"
              data-bs-toggle="tooltip"
              data-bs-placement="top"
              title="Inviter un/e enseignant/e"
            ></i>
					<% end %>
				<% end %>
			</div>
			<ul>
				<% @teachers.each do |teacher| %>
					<li class='teacher-detail-school-card'>
						<%# Un invité n'a ni prénom ni nom tant qu'il n'a pas accepté :
						    `first_name.capitalize` levait un NoMethodError sur cette ligne. %>
						<%= teacher.invitation_pending? ? "Invitation en attente" : teacher.display_name %>
						<div class="teacher-admin">
							<% if teacher.school_role.super_teacher %>
								<i
                  class="fa-solid fa-key --roseL"
                  data-controller="tooltip"
                  data-bs-toggle="tooltip"
                  data-bs-placement="top"
                  title="Responsable du groupe"
                ></i>
							<% end %>
						</div>
						<div class="teacher-email">
							<%# L'adresse en clair pour une invitation en attente : le responsable
							    vient de la saisir, et doit savoir qui il attend. %>
							(<%= teacher.invitation_pending? ? teacher.email : cacher_email(teacher.email) %>)
						</div>
					</li>
				<% end %>
			</ul>
			<div class="grey-line-full"></div>
			<div class="classrooms-details-card">
				<%= render 'grades/grades', grades: @grades %>
				<!--<p>
          <i class="fa-solid fa-people-roof"></i>
          <%= "#{@classrooms.count} / #{@subscription.quantity unless @subscription.nil?} classe#{'s' if @classrooms.count > 1}" %>
        </p>
        <p>
          <i class="fa-solid fa-graduation-cap"></i>
          <%= "#{@students.count} élève#{"s" if @students.count > 1}" %>
        </p> -->
			</div>
		</div>
		<div class="subscription-details --border-10px">
			<% if  @subscription.nil? %>
				Vous n'avez pas encore d'abonnement

			<% else %>
				<h3>Détails de votre Abonnement</h3>
				<p><i class="fa-solid fa-heart"></i>
					<%= t("etats_facturation.#{@subscription.status}") %>
					<%= "(fin le #{@subscription.trial_end})" if @subscription.status == "trialing" %>
				</p>
        <p><i class="fa-solid fa-people-roof"></i> <%= @school.classrooms_total%> / <%= @subscription.quantity %> classe(s) </p>
				<div class="grey-line-full"></div>
        <h5>Renouvellement</h5>
        <p><i class="fa-solid fa-repeat"></i>
					<%= @subscription.rythm %>
          </p>
				<p><i class="fa-solid fa-calendar-xmark"></i>
					<%= @subscription.current_period_end %></p>
				<div class="grey-line-full"></div>
				<div class="school-code">
					<p>Code pour intégrer un enseignant à votre groupe :</p>
					<h4 class="school-code-value"><%= @school.code %></h4>
					<% if policy(@school).renew_code? %>
						<%= button_to renew_code_school_path(@school),
						              method: :patch,
						              class: "school-code-renew",
						              form: { data: { turbo_confirm: "Un nouveau code sera tiré : l'ancien ne permettra plus de vous rejoindre. Continuer ?" } } do %>
							<i class="fa-solid fa-rotate"></i> Renouveler le code
						<% end %>
					<% end %>
				</div>
			<% end %>
		</div>
	</div>
</div>
