<%# Les flèches flottantes : la liste des exercices, une fois les dossiers
    dépliés, fait plusieurs écrans de haut. %>
<%# Les exercices classiques sont un onglet des plans de travail, ceux de ceinture
    un onglet des ceintures : la page prend le titre et les onglets de sa section. %>
<%= render Ui::PageComponent.new(title: @ceinture ? "Ceintures" : "Plans de travail",
                                 tabs: @ceinture ? onglets_ceintures(:exercices) : onglets_plans_de_travail(:exercices)) do %>
<div class="challenges-container"
     data-controller="page-scroll"
     data-action="scroll@window->page-scroll#refresh resize@window->page-scroll#refresh">
	<div data-controller='submitonchange' class='challenge-filter'>
		<%= simple_form_for challenges_path, method: :get,
    html: {id: "domainForm"},
        data: { action: "change->submitonchange#submitForm"
                } do |f| %>
			<%# L'onglet courant suit les changements de filtre. %>
			<%= hidden_field_tag :ceinture, 1, id: nil if @ceinture %>
			<div class="box-column-challenges-filter">
				<div class="challenges-skill">
					<%= f.input :grade,
                  collection: @grades,
                  selected: @grade.id,
                  label: false,
                  input_html: {
                    class: "area grow m-left --text-center"
                  } %>
					<%= f.input :domain,
                  collection: @domains.sort_by(&:position),
                  selected: @domain&.id,
                  label: false,
                  input_html: {
                    class: "area grow m-left"
                  } %>
				</div>
				<div class="challenges-skill-level-selector">

        <p class= 'pt-1 m-left'>Niveau de Ceinture</p>

					<%= f.input :level,
                  # Dernière copie en dur des ceintures : elle écrivait « Vert »
                  # et « Bleu » au masculin, alors qu'une ceinture est verte et
                  # bleue — et que la modale de déplacement, elle, s'accordait.
                  collection: collection_ceintures,
                  selected: @level,
                  label: false,
                  # La liste des couleurs vivait ici en dur, et une seconde fois
                  # dans les options ci-dessus. `classe_ceinture` la tient
                  # désormais en un seul endroit, partagé avec la modale de
                  # déplacement.
                  input_html: {
                    class: "area grow m-left --text-center #{classe_ceinture(@level)}"
                  } %>

				</div>
			</div>
		<% end %>
		<%# Une fiche de ceinture d'aucun élève, pour la ceinture filtrée : toutes ses
		    compétences, le premier exercice de chacune. Elle s'ouvre dans l'éditeur,
		    et se retrouve dans Voir > Ceintures > Non assignées. Hors du formulaire
		    des filtres : un formulaire ne s'imbrique pas dans un autre. %>
		<% if @ceinture && @domain && @skills.exists? %>
			<%= render Ui::ButtonComponent.new("Générer une fiche", variant: :primary, icon: "fa-bacon",
			                                   url: generer_belt_sheets_path(grade_id: @grade.id, domain_id: @domain.id, level: @level),
			                                   title: "Une fiche de ceinture avec un exercice par compétence, à retoucher puis imprimer") %>
		<% end %>
	</div>
	<div class="grey-line"></div>
	<div id='skills-challenge-list'>
		<%# Un niveau sans domaine n'a rien à filtrer : on le dit, et on mène là où on
		    les crée, au lieu de planter sur `@domain.id`. %>
		<% if @domain.nil? %>
			<p class="belt-sheet-empty">
				Aucun domaine pour ce niveau :
				<%= link_to "créez-en depuis Mes compétences", skills_path(grade: @grade&.id) %>.
			</p>
		<% else %>
			<%= render "challenges/skill_folders", skills: @skills, challenges: @challenges, for_belt: @ceinture %>
		<% end %>
	</div>
	<div class="top-floating-btn"
	     data-page-scroll-target="down"
	     data-action="click->page-scroll#down"
	     title="Aller en bas de la page">
		<i class="fa-solid fa-circle-arrow-down"></i>
	</div>
	<div class="bottom-floating-btn"
	     data-page-scroll-target="up"
	     data-action="click->page-scroll#up"
	     title="Remonter en haut de la page">
		<i class="fa-solid fa-circle-arrow-up"></i>
	</div>
</div>
<% end %>
