<%# `in_index` : la liste des exercices d'une compétence (page /challenges). Le
    partiel sert aussi dans l'éditeur de plan de travail et dans le carrousel de
    remplacement, où ni les flèches ni l'auteur n'ont leur place.
    `list_size` n'est fourni que par les rendus de collection : sans lui, pas de
    flèches (on ne sait pas où est la fin de la liste). %>
<% in_index = local_assigns.fetch(:in_index) { params[:controller] == "challenges" && params[:action] == "index" } %>
<% orderable = in_index && local_assigns[:list_size].present? && local_assigns.key?(:challenge_counter) %>

<%# La frame ne contient QUE la carte : éditer un exercice ou l'enregistrer y
    substitue le formulaire, et la gouttière — qui vit à l'extérieur — survit. %>
<% card = capture do %>
  <%= turbo_frame_tag dom_id(challenge) do %>
    <% if policy(challenge).can_show_delete_button? && params[:controller] == "challenges"%>
      <div class="delete-challenge-btn">
        <%= button_to challenge_path(challenge), method: :delete, class: "move-left-btn",
          data: {confirm: "Souhaitez vous supprimer cet éxercice?"} do %>
          <i class="fa-solid fa-circle-xmark"></i>
        <% end %>
      </div>
    <% end %>
    <%= link_to edit_challenge_path(challenge), class:"--color-inherit" do %>
      <div class="cont-challenge pencil-pointor mb-1" id="<%= challenge.id%>">
        <div class= "">
          <div  data-edit-challenge-target="infos">
            <div class="challenge-infos"   data-ajax-replace-challenge-target='content' id='<%=challenge.id %>'>
              <div class="challenge-name-in-content">
                <%= challenge.name%>
              </div>
              <%= challenge.content %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<% infos = capture do %>
  <% if in_index %>
    <div class="challenge-infos-box">
      <%# Un exercice dont l'auteur a quitté l'école n'en a plus : on tait la
          ligne au lieu de planter sur `nil.first_name`. %>
      <% if challenge.user %>
        <p class="ms-5 --grisC --italic"> <i class='fas fa-pen fa-xs'></i> <%= challenge.user.first_name %></p>
      <% end %>
      <%if !challenge.work_plan_skills.empty?  %>
        <p class=" --grisC --italic">Utilisé sur d'autres plans de travail</p>
      <% end %>
    </div>
  <% end %>
<% end %>

<%# La copie d'un clonage atterrit en fin de liste, souvent hors écran : `reveal` la
    désigne pour que le navigateur y descende. %>
<% revealed = local_assigns[:reveal].present? && local_assigns[:reveal].to_s == challenge.id.to_s %>
<% if orderable %>
  <div class="challenge-row" data-controller="<%= "reveal" if revealed %>">
    <div class="challenge-order">
      <div class="challenge-order-row">
        <span class="challenge-order-position" title="Position dans la compétence">
          <%= challenge.position %>
        </span>
        <%# Pas de place réservée pour une flèche absente : en haut et en bas de
            liste, le groupe se resserre. %>
        <% unless challenge_counter.zero? %>
          <%= button_to transfer_challenge_path(challenge, direction: "up"),
                method: :patch,
                class: "challenge-order-btn",
                title: "Monter cet exercice" do %>
            <i class="fa-solid fa-circle-chevron-up"></i>
          <% end %>
        <% end %>
        <% unless challenge_counter == list_size - 1 %>
          <%= button_to transfer_challenge_path(challenge, direction: "down"),
                method: :patch,
                class: "challenge-order-btn",
                title: "Descendre cet exercice" do %>
            <i class="fa-solid fa-circle-chevron-down"></i>
          <% end %>
        <% end %>
      </div>
      <%# Le clone se place en dernière position de la compétence, avec ses propres
          tableaux. Libellé écrit, comme le « Cloner » de l'éditeur de plan de travail. %>
      <%= button_to duplicate_challenge_path(challenge),
                    class: "clone-challenge-btn",
                    title: "Cloner cet exercice" do %>
        <i class="fa-regular fa-clone"></i>
        <span>Cloner</span>
      <% end %>
      <%# Déplacer n'est possible que tant qu'aucun plan de travail ne s'y réfère :
          changer la compétence d'un exercice déjà donné réécrirait l'historique
          d'un élève. Le bouton disparaît alors, plutôt que d'échouer au clic. %>
      <% if policy(challenge).transferable? %>
        <button type="button"
                class="transfer-challenge-btn"
                data-bs-toggle="modal"
                data-bs-target="#transferChallengeModal-<%= challenge.id %>"
                title="Déplacer vers une autre compétence">
          <i class="fa-solid fa-folder-tree"></i>
          <span>Déplacer</span>
        </button>
        <%= render "challenges/transfer_modal", challenge: challenge %>
      <% end %>
    </div>
    <div class="challenge-row-content">
      <%= card %>
      <%= infos %>
    </div>
  </div>
<% else %>
  <%= card %>
  <%= infos %>
<% end %>
