<%= turbo_frame_tag challenge do %>

			<div class="cont-challenge w-100">
				<%# Display editeur, en d-none de base %>
				<div>
					<%= form_for challenge, html: { class: '',  } do |form| %>
          <%= form.hidden_field :skill_id%>
          <%= form.hidden_field :for_belt%>
						<div class="field rt-field pt-2 pb-2" data-controller="rich-text-table table-editor edit-challenge">
							<div>
								<%= form.text_field :name, class: "challenge-title", placeholder: "Nom de l'exercice", aria: { label: "Nom de l'exercice" } %>
							</div>
							<%= form.rich_text_area :content, placeholder: "Écrivez votre énoncé ici…" %>
						</div>
						<div class="form-actions d-flex justify-content-end height-validate-challenge">
            <% if challenge.persisted? %>
							<%= link_to challenge_path(challenge), class:"cancel-btn" do %>
									<i class="fas fa-times"></i>
							<% end%>
              <% else %>
              <%# À la création, l'annulation vide la frame du formulaire. Elle vit dans
                  cette rangée et non après le formulaire : elle y était placée à coups
                  de `top: -103px; left: 577px`, donc jamais alignée sur Enregistrer. %>
							<div class="cancel-btn"
							     data-controller="manageturboframe"
							     data-manageturboframe-id-value="<%= challenge.skill.id %>"
							     data-action="click->manageturboframe#cleanTurboFrame">
								Annuler
							</div>
              <% end %>
							<%= form.submit 'Enregistrer', class: 'validate-challenge-btn'%>
						</div>
					<% end %>
				</div>
			</div>

<% end %>
