<%= turbo_frame_tag challenge do %>

			<div class="cont-challenge w-100">
				<%# Display editeur, en d-none de base %>
				<div>
					<%= form_for challenge, html: { class: '',  } do |form| %>
          <%= form.hidden_field :skill_id%>
          <%= form.hidden_field :for_belt%>
						<div class="field rt-field pt-2 pb-2" data-controller="edit-challenge">
							<div>
								<%# `form_for` n'affiche aucune erreur de lui-même : sans ce bloc, le
								    formulaire réaffiché après un échec de validation ne dirait pas pourquoi. %>
								<% name_errors = challenge.errors.full_messages_for(:name) %>
								<%= form.text_field :name, class: "challenge-title#{' is-invalid' if name_errors.any?}",
								    placeholder: "Nom de l'exercice", aria: { label: "Nom de l'exercice" } %>
								<% if name_errors.any? %>
									<div class="invalid-feedback d-block"><%= name_errors.to_sentence %></div>
								<% end %>
							</div>
							<%# Éditeur TipTap (à la place de Trix). Le champ caché porte le corps au
							    format qu'ActionText échange avec Trix : rien ne change à l'enregistrement.
							    Les tableaux maison y arrivent déjà convertis en tableaux natifs
							    (EditeurTiptap), qui deviennent définitifs à l'enregistrement. %>
							<div class="rt-editeur-champ" data-controller="editeur-enonce"
							     data-editeur-enonce-direct-upload-url-value="<%= main_app.rails_direct_uploads_url %>"
							     data-editeur-enonce-blob-url-template-value="<%= main_app.rails_service_blob_url(":signed_id", ":filename") %>"
							     data-editeur-enonce-placeholder-value="Écrivez votre énoncé ici…">
								<%= form.hidden_field :content, value: EditeurTiptap.contenu_initial(challenge.content),
								    data: { editeur_enonce_target: "input" } %>
								<%# Un exercice à l'ancien format s'édite tel quel (editeur/blocs.js) : ce
								    bandeau, que l'éditeur n'affiche que pour lui, le fait passer au nouveau,
								    ou l'y ramène tant qu'il n'est pas enregistré. %>
								<div class="rt-format" data-editeur-enonce-target="formatAncien" hidden>
									<span class="rt-format__texte">Cet exercice est à l'ancien format : interligne plus large, et un espace entre les paragraphes.</span>
									<%= render Ui::ButtonComponent.new("Passer au nouveau format", size: :sm,
									    data: { action: "editeur-enonce#basculerFormat" }) %>
								</div>
								<div class="rt-format" data-editeur-enonce-target="formatConverti" hidden>
									<span class="rt-format__texte">Exercice passé au nouveau format. Enregistrez pour le garder.</span>
									<%= render Ui::ButtonComponent.new("Revenir à l'ancien format", variant: :neutral, size: :sm,
									    data: { action: "editeur-enonce#basculerFormat" }) %>
								</div>
								<div class="rt-barre" data-editeur-enonce-target="barre"></div>
								<div class="rt-editeur" data-editeur-enonce-target="zone"></div>
								<input type="file" accept="image/*" multiple hidden
								       data-editeur-enonce-target="fichier" data-action="change->editeur-enonce#choisirFichiers">
							</div>
						</div>
						<div class="form-actions d-flex justify-content-end height-validate-challenge">
            <% if challenge.persisted? %>
							<%= render Ui::ButtonComponent.new("Annuler", variant: :neutral, href: challenge_path(challenge)) %>
              <% else %>
              <%# À la création, l'annulation vide la frame du formulaire. Elle vit dans
                  cette rangée et non après le formulaire : elle y était placée à coups
                  de `top: -103px; left: 577px`, donc jamais alignée sur Enregistrer. %>
<%= render Ui::ButtonComponent.new("Annuler", variant: :neutral,
							                                   data: { controller: "manageturboframe",
							                                           manageturboframe_frame_value: "#{'for_belt_' if challenge.for_belt?}skill_#{challenge.skill_id}_new_challenge",
							                                           action: "click->manageturboframe#cleanTurboFrame" }) %>
              <% end %>
							<%= render Ui::ButtonComponent.new("Enregistrer", variant: :primary, type: "submit") %>
						</div>
					<% end %>
				</div>
			</div>

<% end %>
