<%# acts_as_list décale les positions suivantes en base : la liste est re-rendue
    pour que les numéros affichés suivent. %>
<%= turbo_stream.update challenges_list_frame_id do %>
  <%= render "challenges/challenges_list", challenges: @challenges %>
<% end %>
<%= turbo_stream.update challenges_frame_id("count"), "#{@count} exo#{@count > 1 ? "s" : ""}" %>
