<%= turbo_stream.prepend "flash" , partial: "shared/flashes" %>
<%# Un nouvel exercice se place en fin de liste (acts_as_list, add_new_at:
    :bottom) : on re-rend la liste pour que sa position et les flèches de son
    prédécesseur soient justes tout de suite. %>
<%= turbo_stream.update challenges_list_frame_id do %>
  <%= render "challenges/challenges_list", challenges: @challenges %>
<% end %>
<%= turbo_stream.update challenges_frame_id("new_challenge"), "" %>
<%= turbo_stream.update challenges_frame_id("count"), "#{@count} exo#{@count > 1 ? "s" : ""}" %>
