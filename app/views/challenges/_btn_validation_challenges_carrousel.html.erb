<%# Sans exercice courant, on ne peut pas revenir à sa fiche : on re-rend le WPS,
    qui réaffiche les CTA Charger / Créer. Une ligne de fiche de ceinture, elle,
    se re-rend toujours entière : c'est elle que le carrousel a remplacée. %>
<% holder = local_assigns[:holder] || work_plan_skill %>
<% cancel_path = if holder.is_a?(BeltSheetSkill)
                   belt_sheet_skill_path(holder)
                 elsif holder.challenge.nil?
                   work_plan_skill_path(holder)
                 else
                   challenge_path(holder.challenge)
                 end %>
<%= link_to cancel_path,
  class:"carrousel-cancellation --roseL --bgc-blanc --cursor-pointer" do %>
  <i class="fa-solid fa-circle-xmark"></i>
<% end %>

<%= simple_form_for holder do |f| %>
  <%= f.hidden_field :challenge_id, value: challenge.id %>
  <%# <input type='submit' value='' class="btn"> %>
  <div class="carrousel-validation">
    <i class="fa-solid fa-circle-check --cursor-pointer --vert"></i>
    <%= f.submit nil, class:'hidden-validation' %>
  </div>
<% end %>
