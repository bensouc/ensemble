<%# Les dossiers d'une ceinture, une compétence par dossier. Le même partiel sert
    aux exercices classiques et aux exercices de ceinture : deux listes qui ne se
    mélangent jamais, d'où le préfixe des identifiants — ceux que visent les
    turbo streams du contrôleur (`challenges_frame_id`). %>
<% prefix = for_belt ? "for_belt_" : "" %>
<div class="challenges-display">
	<% if skills.empty? %>
		<p>Il n'y a pas de compétences pour cette ceinture</p>
	<% else %>
		<% skills.sort_by(&:position).each do |skill| %>
			<% skill_challenges = challenges.select { |chall| chall.skill_id == skill.id } %>
			<%# L'identifiant sert au transfert d'un exercice : le dossier concerné
			    est rouvert pour qu'on voie l'arrivée, plutôt que de la deviner. %>
			<div class="challenges-by-skill mb-2" id="<%= prefix %>dossier_skill_<%= skill.id %>" data-controller='wp-by-student'>
				<div class="d-flex challenge-skill-header">
					<div class='d-flex wp-student-folder'
					     data-action="click->wp-by-student#displayList">
						<div class="index-folder">
							<i class="fa-solid fa-folder-closed me-4 ms-3"
							   data-wp-by-student-target="folderopen"></i>
							<i class="fa-solid fa-folder-open me-4 ms-3 d-none"
							   data-wp-by-student-target="folderclosed"></i>
						</div>
						<div class='index-wp-name d-flex'>
							<div class="wp-firstname max-length-skill-name">
								<%= skill.name %>
							</div>
							<div class='invisible'>
								--
							</div>
							<div class="index-wp-count" data-wp-by-student-target='count'>
								<%= turbo_frame_tag "#{prefix}skill_#{skill.id}_count" do %>
									<%= skill_challenges.size %> exo<%= skill_challenges.size > 1 ? "s" : "" %>
								<% end %>
							</div>
						</div>
					</div>
					<%# Le CTA est un frère de la zone cliquable, pas un enfant : pas besoin
					    d'arrêter la propagation pour éviter de replier le dossier. %>
					<%= link_to new_challenge_path(skill: skill, for_belt: (true if for_belt)),
					            data: { turbo_frame: "#{prefix}skill_#{skill.id}_new_challenge",
					                    action: "click->wp-by-student#openList" },
					            class: "add-folder-btn",
					            title: for_belt ? "Ajouter un exercice de ceinture à cette compétence" : "Ajouter un exercice à cette compétence" do %>
						<i class="fa-solid fa-circle-plus"></i>
						<span>Ajouter</span>
					<% end %>
				</div>
				<div data-wp-by-student-target="wplist" class='list-wp-index d-none p-0'>
					<%= turbo_frame_tag "#{prefix}#{dom_id(skill)}_challenges_list" do %>
						<%= render "challenges/challenges_list", challenges: skill_challenges %>
					<% end %>
					<%# En dernier : le nouvel exercice se placera en fin de liste, juste
					    au-dessus de ce formulaire. La gouttière vide met la carte du
					    formulaire dans la même grille que les cartes d'exercice — le
					    partiel `challenges/_form`, partagé avec l'édition, n'est pas touché. %>
					<div class="challenge-row new-challenge-row">
						<div class="challenge-order-placeholder"></div>
						<%= turbo_frame_tag "#{prefix}skill_#{skill.id}_new_challenge", class: "challenge-row-content" %>
					</div>
				</div>
			</div>
		<% end %>
	<% end %>
</div>
