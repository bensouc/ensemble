<div
  class='border-skill justify-content-between mt-2 edit-skill-card'
  data-allskilldisplay-target='skillCard'
>
	<%= simple_form_for skill,html: { novalidate: false, class: "skill-edit-form"},
                            data: {create_skill_display_target:'form'} do |f| %>
		<div>
			<%# validates :name, presence: true
      validates :symbol,
      inclusion: {
        in: ["◼", "⬥", "⬟", "♥", "⬤", "♣", "🞮", "▲", ""]
      } %>
			<%= f.input :symbol,
              label: false,
              collection: %w[◼ ⬥ ⬟ ♥ ⬤ ♣ 🞮 ▲],
              input_html: {
                class: "area"
              }%>
		</div>
		<div class="skill-name-input">
			<%= f.input :name,
              as: :text,
              label: false,
              placeholder: "Nom de la compétence",
              required: :true,
              input_html: {
                class: "area"
              } %>
		</div>
		<div class="d-none">
			<%# Un champ caché et non `f.association` : simple_form y aurait mis
			    `Domain.all`, les domaines de toutes les écoles, dans chaque
			    formulaire de la page. %>
			<%= f.hidden_field :domain_id %>
			<%= f.input :level, label: false, required: :true %>
		</div>
		<div>
			<%# here comes the submit %>
			<% tb_frame_id =
        skill.id.nil? ? "#{skill.domain.id}_#{skill.level}" : "skill_#{skill.id}" %>
			<%= f.submit "Ok",
               class: "area rect-sm btn-valid skill-submit",
               data: {
                 turbo_frame: tb_frame_id,
                 action: "click->create-skill-display#hideForm"
               } %>
		</div>
	<% end %>
</div>
