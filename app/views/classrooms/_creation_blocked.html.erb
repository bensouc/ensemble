<%# Chaque cause a sa consigne : le responsable reçoit l'action qu'il peut faire
    lui-même, les autres le nom de la personne à qui s'adresser. %>
<% responsable = current_user.super_teacher? %>
<div class="classroom-creation-blocked">
	<% case classroom_creation_block_reason(current_user) %>
	<% when :demo %>
		<p class="classroom-blocked-reason">
			Compte de démonstration : vous êtes limité à <%= User::DEMO_CLASSROOM_LIMIT %> classe.
		</p>
		<%= link_to "Abonnez-vous pour en créer d'autres", subscriptions_on_boarding_path, class: "btn-flat" %>

	<% when :no_subscription %>
		<% if responsable %>
			<p class="classroom-blocked-reason">Votre groupe n'a pas encore d'abonnement.</p>
			<%= link_to "Souscrire un abonnement", new_subscription_path, class: "btn-flat" %>
		<% else %>
			<p class="classroom-blocked-reason">
				Votre groupe n'a pas encore d'abonnement.
				Demandez à <%= super_teachers_label(@school) %> d'en souscrire un.
			</p>
		<% end %>

	<% when :inactive_subscription %>
		<% etat = t("etats_facturation.#{@school.subscription.status}").downcase %>
		<% if responsable %>
			<p class="classroom-blocked-reason">
				La création de classe est suspendue : votre abonnement est <%= etat %>.
			</p>
			<%= render "classrooms/portail_abonnement", libelle: "Reprendre mon abonnement", repli: true %>
		<% else %>
			<p class="classroom-blocked-reason">
				La création de classe est suspendue : l'abonnement du groupe est <%= etat %>.
				Prévenez <%= super_teachers_label(@school) %>.
			</p>
		<% end %>

	<% when :quota_exceeded %>
		<%# Baisser la quantité chez Stripe ne supprime aucune classe : le groupe
		    peut se retrouver au-dessus de son plafond. Dire l'écart, et de combien
		    il faut descendre. %>
		<% if responsable %>
			<p class="classroom-blocked-reason">
				Votre groupe a <%= classes_label(@school.classrooms_total) %> pour
				<%= classes_label(@school.subscription.quantity.to_i) %> à l'abonnement.
				Supprimez-en <%= @school.classrooms_surplus %>, ou ajoutez-les à votre abonnement.
			</p>
			<%= render "classrooms/portail_abonnement", libelle: "Ajouter une classe à mon abonnement" %>
		<% else %>
			<p class="classroom-blocked-reason">
				Le groupe a <%= classes_label(@school.classrooms_total) %> pour
				<%= classes_label(@school.subscription.quantity.to_i) %> à l'abonnement.
				Demandez à <%= super_teachers_label(@school) %> d'ajuster l'abonnement.
			</p>
		<% end %>

	<% else %>
		<% payees = @school.subscription.quantity.to_i %>
		<% accord = payees > 1 ? "toutes utilisées" : "déjà utilisée" %>
		<% if responsable %>
			<p class="classroom-blocked-reason">
				Votre abonnement couvre <%= classes_label(payees) %>, <%= accord %>.
			</p>
			<%= render "classrooms/portail_abonnement", libelle: "Ajouter une classe à mon abonnement" %>
		<% else %>
			<p class="classroom-blocked-reason">
				L'abonnement du groupe couvre <%= classes_label(payees) %>, <%= accord %>.
				Demandez à <%= super_teachers_label(@school) %> d'en ajouter une.
			</p>
		<% end %>
	<% end %>
</div>
