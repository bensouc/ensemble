<%# Choix des domaines avant une génération automatique, depuis la fiche d'un élève
    ou les résultats de sa classe. Le plan s'ouvre dans un nouvel onglet : la
    modale se masque à l'envoi, sinon elle restait ouverte derrière.
    Plus de contrôleur `checkboxes` : il cochait toutes les cases à l'ouverture,
    et les domaines que le professeur a sortis de la génération automatique
    doivent arriver décochés. %>
<div class="modal-ensemble" data-controller="modals">
  <%= simple_form_for student, url: student_auto_new_wp_path(student), method: :post,
                      html: { target: "_blank",
                              data: { action: "submit->modals#emptyModal", turbo: false, turbo_frame: "_top" } } do |form| %>
    <div class="modal-ensemble-dialog">
      <div class="modal-ensemble-content modal-domaines">
        <div class="modal-ensemble-header">
          <h5 class="modal-title">
            Domaines à générer pour <%= student.first_name.capitalize %>
          </h5>
          <button type="button" class="btn-close" aria-label="Fermer"
                  data-action="click->modals#emptyModal"></button>
        </div>
        <div class="modal-body">
          <div class="domain-choice">
            <%= form.input_field :domains,
                                 collection: domains,
                                 value_method: lambda { |domain| domain.id },
                                 multiple: true,
                                 as: :check_boxes,
                                 boolean_style: :inline,
                                 class: "tag-selector",
                                 item_wrapper_class: "tag-item",
                                 checked: checked_domains.map(&:id) %>
          </div>
        </div>
        <div class="modal-ensemble-footer wp-new-actions">
          <p class="wp-new-hint">
            <em>Le plan de travail s'ouvrira dans un nouvel onglet.</em>
          </p>
          <%= form.button :button, "Générer le plan", class: "utility-wp-btn utility-wp-btn--primary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
