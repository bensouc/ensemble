<%# Même modèle que la modale d'édition d'un plan de travail : des champs
    libellés en grille (`wp-edit-form`), et le pied Annuler / Valider en
    `Ui::ButtonComponent`. Le formulaire enveloppe le corps ET le pied. %>
<div class="modal fade" id="editingClassroomModal-<%=classroom.id%>" tabindex="-1" aria-labelledby="editingClassroomModal-<%=classroom.id%>Label" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="editingClassroomModal-<%=classroom.id%>Label">Modifier la classe</h5>
				<%= render Ui::ButtonComponent.new(variant: :icon, icon: "fa-xmark", title: "Fermer", html: { class: "ms-auto" }, data: { bs_dismiss: "modal" }) %>
			</div>
			<%= simple_form_for classroom, html: { novalidate: false, class: "wp-edit-form" } do |f| %>
				<div class="modal-body">
					<%# Le niveau ne se change pas après coup : il est montré, pas envoyé. %>
					<div class="form-group wp-edit-full-row">
						<label for="classroom_grade_<%= classroom.id %>">Niveau</label>
						<input type="text" id="classroom_grade_<%= classroom.id %>" class="area form-control"
						       value="<%= classroom.grade&.grade_level&.upcase %>" disabled>
					</div>
					<%= f.input :name, label: "Nom de la classe", wrapper_html: { class: "wp-edit-full-row" },
					            hint: "Facultatif : sans nom, la classe porte celui de son niveau.",
					            input_html: { class: "area", id: "classroom_name_#{classroom.id}" } %>
				</div>
				<div class="modal-footer">
					<%= render Ui::ButtonComponent.new("Annuler", variant: :neutral, data: { bs_dismiss: "modal" }) %>
					<%= render Ui::ButtonComponent.new("Valider", variant: :primary, type: "submit",
					                                   data: { turbo_frame: "_top" }) %>
				</div>
			<% end %>
		</div>
	</div>
</div>
