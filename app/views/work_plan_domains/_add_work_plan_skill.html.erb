
<div data-controller="skill-add" class='pt-3'>
	<div data-skill-add-target="button" data-action="click->skill-add#displayForm" class='add-item-btn'>
		<i class="fa-solid fa-circle-plus"></i>
		<h6>Ajouter une compétence</h6>
	</div>
	<div class="d-none" data-skill-add-target="form">
		<%# Une seule ligne, centrée : la compétence, le type, puis les boutons. Le
		    `class: 'd-flex'` d'avant, passé à `simple_form_for` hors de `html:`, ne
		    touchait pas le formulaire — les boutons tombaient à la ligne. %>
		<%= simple_form_for [WorkPlanSkill.new], url: work_plan_domain_work_plan_skills_path(work_plan_domain), method: :post,
		                    html: { novalidate: false, class: "d-flex align-items-center flex-wrap gap-2 mt-2" } do |f| %>
			<%= select_tag :skill, options_competences_a_ajouter(work_plan_domain),
			               prompt: "Sélectionnez une compétence", class: "skill-selector m-0", required: true %>
			<%= select_tag :kind, raw("<option>jeu</option><option>exercice</option><option>ceinture</option>"),
			               prompt: "Sélectionnez un type", class: "skill-selector m-0", required: true %>
			<%= render Ui::ButtonComponent.new("Annuler", variant: :neutral,
			                                   data: { action: "click->skill-add#displayForm" }) %>
			<%= render Ui::ButtonComponent.new("Valider", variant: :primary, type: "submit") %>
		<% end %>
	</div>
</div>
