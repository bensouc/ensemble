
<div data-controller="skill-add" class='pt-3'>
	<div data-skill-add-target="button" data-action="click->skill-add#displayForm" class='add-item-btn'>
		<i class="fa-solid fa-circle-plus"></i>
		<h6>Ajouter une compétence</h6>
	</div>
	<div class="d-none" data-skill-add-target="form">
		<%= simple_form_for [WorkPlanSkill.new ], html: { novalidate: false }, url:  work_plan_domain_work_plan_skills_path(work_plan_domain), method: :post, class:'d-flex'  do |f| %>
			<div class=" d-flex justify-content-between pb-1 ">
				<div class='d-flex '>
					<%= select_tag :skill, options_competences_a_ajouter(work_plan_domain),
					               prompt: "Sélectionnez une compétence", class: "skill-selector", required: true %>
				</div>
				<div>
					<%= select_tag :kind, raw("<option>jeu</option><option>exercice</option><option>ceinture</option>"), :prompt => "Sélectionnez Un type" ,class: 'skill-selector', :required => true %>
				</div>
			</div>
			<div class="d-flex gap-2 mt-2">
				<%= render Ui::ButtonComponent.new("Annuler", variant: :neutral,
				                                   data: { action: "click->skill-add#displayForm" }) %>
				<%= render Ui::ButtonComponent.new("Valider", variant: :primary, type: "submit") %>
			</div>
		<% end %>
	</div>
</div>
