<%# Ajouter un domaine au plan, en deux temps : le domaine, puis sa ceinture —
    en pastilles (`Ui::ChoiceChipComponent`), la ceinture avec son icône à sa
    couleur. Un domaine spécial n'a qu'une ceinture : `domain-form` coche la
    blanche et passe directement aux envois. Ceux-ci restent cachés (`d-none`)
    tant qu'aucune ceinture n'est choisie. %>
<%= turbo_frame_tag :edit_new_domain do %>
	<div class="add-domain" data-controller='new-domain'>
		<div class="add-domain-form" data-new-domain-target='domainform' data-controller='domain-form'>
			<%= simple_form_for work_plan, url: work_plan_work_plan_domains_path(work_plan),
			                    method: :post, html: { novalidate: true },
			                    data: { turbo_frame: "new_domain", action: "submit->navigation#backToBottom" } do %>
				<div class="ui-step">
					<div class="ui-step-title"><span class="ui-step-num">1</span>Domaine</div>
					<div class="ui-chips">
						<% @domains.each do |domain| %>
							<%= render Ui::ChoiceChipComponent.new(name: "work_plan[work_plan_domain][domain]", value: domain.id,
							                                       label: domain.name,
							                                       data: { action: "change->domain-form#displayBelt",
							                                               special: domain.special? }) %>
						<% end %>
					</div>
				</div>
				<div class="ui-step d-none" data-domain-form-target="beltForm">
					<div class="ui-step-title"><span class="ui-step-num">2</span>Ceinture</div>
					<div class="ui-chips">
						<% WorkPlanDomain::LEVELS.each do |level| %>
							<%= render Ui::ChoiceChipComponent.new(name: "work_plan[work_plan_domain][level]", value: level,
							                                       label: Belt::BELT_COLORS[level - 1].capitalize, belt: level,
							                                       data: { domain_form_target: "box",
							                                               action: "change->domain-form#displayBtn" }) %>
						<% end %>
					</div>
				</div>
				<div class="box-end gap-2" id="dmn-validate">
					<%= render Ui::ButtonComponent.new("Annuler", variant: :neutral,
					                                   href: work_plan_path(work_plan, anchor: "bottom")) %>
					<%= render Ui::ButtonComponent.new("Exercices", variant: :primary, type: "submit",
					                                   data: { domain_form_target: "btn" },
					                                   html: { name: "kind", value: "exercice", class: "d-none" }) %>
					<%= render Ui::ButtonComponent.new("Ceinture", variant: :primary, type: "submit",
					                                   data: { domain_form_target: "btn" },
					                                   html: { name: "kind", value: "ceinture", class: "d-none" }) %>
				</div>
			<% end %>
		</div>
	</div>
<% end %>
